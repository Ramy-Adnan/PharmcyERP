<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.ReceiptEditDialog" Title="{Binding DialogTitle}" Height="600" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13" MinWidth="440" MinHeight="340">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم الدافع" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PayerName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="التاريخ" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ReceiptDate}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="المبلغ" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="يُودع في" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}" Padding="6" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsCashSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="الصندوق النقدي" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CashBoxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CashBoxId}" Padding="6" Margin="0,0,0,12"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBankSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="الحساب البنكي" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BankAccounts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BankAccountId}" Padding="6" Margin="0,0,0,12"/>
                    </StackPanel>
                    <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="1" Margin="0,16,0,0" Background="#F8FAFC" Padding="12">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
