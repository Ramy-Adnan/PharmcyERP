<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.CashAndBankView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="الصناديق والحسابات البنكية" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,8,4"/>
                <Button Content="تحديث" Margin="16,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الصناديق النقدية" FontWeight="SemiBold" FontSize="14" Margin="12,10" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                    <Border Style="{StaticResource WorkspaceCardStyle}" DockPanel.Dock="Bottom" Margin="10" Background="#F8FAFC" Padding="12">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="صندوق جديد" Margin="0,0,8,0" Command="{Binding AddCashBoxCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="تعديل" Command="{Binding EditCashBoxCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصندوق" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                            <DataGridTextColumn Header="الحساب المحاسبي" Binding="{Binding AccountName}" Width="130"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الحسابات البنكية" FontWeight="SemiBold" FontSize="14" Margin="12,10" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                    <Border Style="{StaticResource WorkspaceCardStyle}" DockPanel.Dock="Bottom" Margin="10" Background="#F8FAFC" Padding="12">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حساب بنكي جديد" Margin="0,0,8,0" Command="{Binding AddBankAccountCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="تعديل" Command="{Binding EditBankAccountCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="البنك" Binding="{Binding BankName}" Width="120"/>
                            <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountNumber}" Width="120"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
