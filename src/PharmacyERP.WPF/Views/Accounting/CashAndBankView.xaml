<UserControl x:Class="PharmacyERP.WPF.Views.Accounting.CashAndBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الصناديق والحسابات البنكية" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="تحديث" Margin="16,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الصناديق النقدية" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                        <Button Content="صندوق جديد" Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding AddCashBoxCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="تعديل" Padding="12,6" Command="{Binding EditCashBoxCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصندوق" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                            <DataGridTextColumn Header="الحساب المحاسبي" Binding="{Binding AccountName}" Width="130"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الحسابات البنكية" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                        <Button Content="حساب بنكي جديد" Padding="12,6" Margin="0,0,8,0"
                                Command="{Binding AddBankAccountCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="تعديل" Padding="12,6" Command="{Binding EditBankAccountCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="البنك" Binding="{Binding BankName}" Width="120"/>
                            <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountNumber}" Width="120"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
