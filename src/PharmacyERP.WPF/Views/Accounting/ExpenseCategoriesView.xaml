<UserControl x:Class="PharmacyERP.WPF.Views.Accounting.ExpenseCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="فئات المصاريف" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="فئة جديدة" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddCategoryCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تعديل" Padding="12,6" Command="{Binding EditCategoryCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الفئة" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="حساب المصروف الافتراضي" Binding="{Binding DefaultExpenseAccountName}" Width="220"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
