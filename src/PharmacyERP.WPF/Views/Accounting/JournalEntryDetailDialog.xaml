<Window x:Class="PharmacyERP.WPF.Views.Accounting.JournalEntryDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل القيد" Height="520" Width="700"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="رقم القيد" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الفرع" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.BranchName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="التاريخ" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.EntryDate, StringFormat=yyyy-MM-dd}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="المصدر" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.ReferenceType}" FontWeight="SemiBold"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      RowHeight="32" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="90"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding DebitAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding CreditAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="إغلاق" Padding="18,8" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
