<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.JournalEntryDetailDialog" Title="تفاصيل القيد" Height="520" Width="700" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13" ResizeMode="CanResize" MinWidth="500" MinHeight="340">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Style="{StaticResource WorkspaceCardStyle}">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="رقم القيد" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الفرع" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.BranchName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="التاريخ" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.EntryDate, StringFormat=yyyy-MM-dd}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="المصدر" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.ReferenceType}" FontWeight="SemiBold"/>
                </StackPanel>
            </UniformGrid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="90"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding DebitAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding CreditAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="3" Margin="0,16,0,0" Background="#F8FAFC" Padding="12">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
