<Window x:Class="PharmacyERP.WPF.Views.Accounting.PaymentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="600" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="الفرع" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="اسم المستفيد" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PayeeName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="التاريخ" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding PaymentDate}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="المبلغ" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="يُصرف من" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}" Padding="6" Margin="0,0,0,12"/>

            <StackPanel Visibility="{Binding IsCashSource, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="الصندوق النقدي" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding CashBoxes}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding CashBoxId}" Padding="6" Margin="0,0,0,12"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsBankSource, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="الحساب البنكي" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding BankAccounts}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding BankAccountId}" Padding="6" Margin="0,0,0,12"/>
            </StackPanel>

            <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
