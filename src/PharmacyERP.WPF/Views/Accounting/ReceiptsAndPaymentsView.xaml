<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.ReceiptsAndPaymentsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="سندات القبض والصرف" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,8,4"/>
                <Button Content="تحديث" Margin="16,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="سندات القبض" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        <Button Content="سند قبض جديد" Margin="12,0,0,0" Command="{Binding AddReceiptCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Receipts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="12" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="90"/>
                            <DataGridTextColumn Header="الدافع" Binding="{Binding PayerName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="المصدر" Binding="{Binding SourceType}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="سندات الصرف" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        <Button Content="سند صرف جديد" Margin="12,0,0,0" Command="{Binding AddPaymentCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="12" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="90"/>
                            <DataGridTextColumn Header="المستفيد" Binding="{Binding PayeeName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="المصدر" Binding="{Binding SourceType}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
