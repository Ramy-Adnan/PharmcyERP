<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.JournalEntriesView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="القيود اليومية" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,8,4"/>
                <Button Content="قيد يدوي جديد" Margin="16,0,0,0" Command="{Binding AddManualEntryCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
            <DockPanel>
                <Border Style="{StaticResource WorkspaceCardStyle}" DockPanel.Dock="Bottom" Margin="10" Background="#F8FAFC" Padding="12">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="فتح التفاصيل" Command="{Binding OpenDetailCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="110"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="المصدر" Binding="{Binding ReferenceType}" Width="120"/>
                        <DataGridTextColumn Header="إجمالي المدين" Binding="{Binding TotalDebit, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="إجمالي الدائن" Binding="{Binding TotalCredit, StringFormat=N2}" Width="100"/>
                        <DataGridCheckBoxColumn Header="مرحّل" Binding="{Binding IsPosted}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
