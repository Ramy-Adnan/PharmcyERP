<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Accounting.ExpenseCategoryEditDialog" Title="{Binding DialogTitle}" Height="520" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13" MinWidth="420" MinHeight="340">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="اسم الفئة" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="حساب المصروف الافتراضي" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedValuePath="Id" SelectedValue="{Binding DefaultExpenseAccountId}" Padding="6" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} - {1}">
                                            <Binding Path="Code"/>
                                            <Binding Path="Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="1" Margin="0,16,0,0" Background="#F8FAFC" Padding="12">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
