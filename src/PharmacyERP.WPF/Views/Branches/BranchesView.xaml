<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Branches.BranchesView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel>
                <TextBlock Text="الفروع والمخازن" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
                <Button Content="فرع جديد" Margin="16,0,0,0" Command="{Binding AddBranchCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DockPanel>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0" HorizontalAlignment="Left">
                            <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditBranchCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                            <Button Content="تفعيل / تعطيل" Margin="0,0,8,0" Command="{Binding ToggleBranchStatusCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                            <Button Content="حذف" Command="{Binding DeleteBranchCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="اسم الفرع" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="عدد المخازن" Binding="{Binding WarehouseCount}" Width="90"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="المخازن" Margin="12,10" TextWrapping="Wrap" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0" HorizontalAlignment="Left">
                            <Button Content="مخزن جديد" Margin="0,0,8,0" Command="{Binding AddWarehouseCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                            <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditWarehouseCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                            <Button Content="حذف" Command="{Binding DeleteWarehouseCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="اسم المخزن" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="افتراضي" Binding="{Binding IsDefault}" Width="70"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
