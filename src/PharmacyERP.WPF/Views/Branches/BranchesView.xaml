<UserControl x:Class="PharmacyERP.WPF.Views.Branches.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الفروع والمخازن" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="فرع جديد" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddBranchCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                        <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditBranchCommand}"/>
                        <Button Content="تفعيل / تعطيل" Padding="12,6" Margin="0,0,8,0" Command="{Binding ToggleBranchStatusCommand}"/>
                        <Button Content="حذف" Padding="12,6" Foreground="#DC2626" Command="{Binding DeleteBranchCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="34" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="اسم الفرع" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="عدد المخازن" Binding="{Binding WarehouseCount}" Width="90"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="المخازن" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                        <Button Content="مخزن جديد" Padding="12,6" Margin="0,0,8,0" Command="{Binding AddWarehouseCommand}"/>
                        <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditWarehouseCommand}"/>
                        <Button Content="حذف" Padding="12,6" Foreground="#DC2626" Command="{Binding DeleteWarehouseCommand}"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="34" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="اسم المخزن" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="افتراضي" Binding="{Binding IsDefault}" Width="70"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
