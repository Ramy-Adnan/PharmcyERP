<Window x:Class="PharmacyERP.WPF.Views.Branches.BranchEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="رمز الفرع" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="اسم الفرع" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="نوع الفرع" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding BranchTypes}" SelectedItem="{Binding Type}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="العنوان" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="الرقم الضريبي" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="رقم الإجازة (الترخيص)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
