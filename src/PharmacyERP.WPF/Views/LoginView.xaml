<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:PharmacyERP.WPF.Converters" x:Class="PharmacyERP.WPF.Views.LoginView" Title="تسجيل الدخول - Pharmacy ERP" Height="560" Width="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="12">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Width="54" Height="54" Background="#E8F3EC" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Data="M 13 0 L 23 0 L 23 13 L 36 13 L 36 23 L 23 23 L 23 36 L 13 36 L 13 23 L 0 23 L 0 13 L 13 13 Z" Fill="#1F6F50" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pharmacy ERP" FontSize="26" FontWeight="Bold" Foreground="#1F6F50" HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة الصيدليات المتكامل" Style="{StaticResource WorkspaceMutedTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="تسجيل الدخول" Style="{StaticResource WorkspaceSectionHeaderStyle}" Margin="0,0,0,16"/>
                    <TextBlock Text="اسم المستخدم" Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox Height="40" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="0,0,0,14"/>
                    <TextBlock Text="كلمة المرور" Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBoxControl" Height="40" FontSize="14"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <Button Content="دخول" Height="44" FontSize="15" Margin="0,18,0,0" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanAttemptLogin}" Click="LoginButton_Click" IsDefault="True"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="4" Text="© ALIBA - Pharmacy ERP System" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
