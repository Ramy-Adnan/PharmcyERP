<Window x:Class="PharmacyERP.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PharmacyERP.WPF.Converters"
        Title="تسجيل الدخول - Pharmacy ERP"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Border BorderBrush="#D9DEE3" BorderThickness="1" Background="White" CornerRadius="6" Margin="0">
        <Grid Margin="40,30,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Pharmacy ERP" FontSize="26" FontWeight="Bold" Foreground="#1F6F50" HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة الصيدليات المتكامل" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="اسم المستخدم" FontSize="13" Foreground="#374151" Margin="0,0,0,6"/>
            <TextBox Grid.Row="2" Margin="0,22,0,0" Height="38" Padding="8,6"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"/>

            <TextBlock Grid.Row="4" Text="كلمة المرور" FontSize="13" Foreground="#374151" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBoxControl" Grid.Row="4" Margin="0,22,0,0" Height="38" Padding="8,6" FontSize="14"/>

            <TextBlock Grid.Row="6" Text="{Binding ErrorMessage}"
                       Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button Grid.Row="8" Content="دخول" Height="42" FontSize="15" FontWeight="SemiBold"
                    Background="#1F6F50" Foreground="White" BorderThickness="0"
                    IsEnabled="{Binding CanAttemptLogin}"
                    Click="LoginButton_Click"
                    IsDefault="True"/>

            <TextBlock Grid.Row="10" Text="© ALIBA - Pharmacy ERP System" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
