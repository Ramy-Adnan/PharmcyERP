                                         Content="المستخدمون"
                                         ToolTip="المستخدمون"
                                         Tag="{StaticResource Icon.User}"
                                         Command="{Binding NavigateToUsersCommand}"
                                         Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="الأدوار والصلاحيات"
                                         ToolTip="الأدوار والصلاحيات"
                                         Tag="{StaticResource Icon.Key}"
                                         Command="{Binding NavigateToRolesCommand}"
                                         Visibility="{Binding CanManageRoles, Converter={StaticResource BoolToVisibilityConverter}}"/>


