                                         Visibility="{Binding CanManageExpenses, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="سندات القبض والصرف"
