                            </StackPanel>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="نقطة البيع (POS)"
                                         ToolTip="نقطة البيع (POS)"
                                         Tag="{StaticResource Icon.Pos}"
                                         Command="{Binding NavigateToPosCommand}"
                                         Visibility="{Binding CanUsePos, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="فواتير المبيعات"
                                         ToolTip="فواتير المبيعات"
                                         Tag="{StaticResource Icon.Invoice}"
                                         Command="{Binding NavigateToSalesInvoicesCommand}"
                                         Visibility="{Binding CanViewSalesInvoices, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="العملاء"
                                         ToolTip="العملاء"
                                         Tag="{StaticResource Icon.User}"
                                         Command="{Binding NavigateToCustomersCommand}"
                                         Visibility="{Binding CanManageCustomers, Converter={StaticResource BoolToVisibilityConverter}}"/>


