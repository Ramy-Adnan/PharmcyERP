                                <TextBlock Text="الإدارة" Style="{StaticResource NavSectionTitle}"/>
                                <Border Style="{StaticResource NavCollapsedDivider}"/>
                            </StackPanel>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="الفروع والمخازن"
                                         ToolTip="الفروع والمخازن"
                                         Tag="{StaticResource Icon.Branch}"
                                         Command="{Binding NavigateToBranchesCommand}"
                                         Visibility="{Binding CanManageBranches, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
