                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="لوحة التحكم"
                                         ToolTip="لوحة التحكم"
                                         Tag="{StaticResource Icon.Dashboard}"
                                         Command="{Binding NavigateToDashboardCommand}"
                                         Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVisibilityConverter}}"/>


                            <!-- ============================= -->
                            <!-- REPORTS -->
                            <!-- ============================= -->

                            <StackPanel Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="التقارير" Style="{StaticResource NavSectionTitle}"/>
                                <Border Style="{StaticResource NavCollapsedDivider}"/>
                            </StackPanel>

                            <RadioButton Style="{StaticResource NavItemStyle}"
