                                         Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="ميزان المراجعة"
                                         ToolTip="ميزان المراجعة"
                                         Tag="{StaticResource Icon.Balance}"
                                         Command="{Binding NavigateToTrialBalanceCommand}"
                                         Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="قائمة الدخل"
                                         ToolTip="قائمة الدخل"
                                         Tag="{StaticResource Icon.Income}"
                                         Command="{Binding NavigateToIncomeStatementCommand}"
