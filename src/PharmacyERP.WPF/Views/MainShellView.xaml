                                         Tag="{StaticResource Icon.Supplier}"
                                         Command="{Binding NavigateToSuppliersCommand}"
                                         Visibility="{Binding CanManageSuppliers, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="أوامر الشراء"
                                         ToolTip="أوامر الشراء"
                                         Tag="{StaticResource Icon.PurchaseOrder}"
