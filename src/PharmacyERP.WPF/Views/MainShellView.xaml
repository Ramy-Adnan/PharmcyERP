                                <TextBlock Text="المحاسبة" Style="{StaticResource NavSectionTitle}"/>
                                <Border Style="{StaticResource NavCollapsedDivider}"/>
                            </StackPanel>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="دليل الحسابات"
                                         ToolTip="دليل الحسابات"
