                                         Visibility="{Binding CanManageHrAttendance, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="عمولات الموظفين"
                                         ToolTip="عمولات الموظفين"
                                         Tag="{StaticResource Icon.Percent}"
                                         Command="{Binding NavigateToCommissionsCommand}"
                                         Visibility="{Binding CanManageHrCommissions, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
