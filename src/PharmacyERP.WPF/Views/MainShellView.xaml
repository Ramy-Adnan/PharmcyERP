<Window x:Class="PharmacyERP.WPF.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy ERP"
        Height="720"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Tag="{Binding IsChecked, ElementName=CollapseToggle}">

    <!--
        ملاحظة: خاصية Tag الخاصة بالنافذة تحمل حالة طي القائمة (True = مطوية)
        وتستخدمها الـ Styles لإخفاء النصوص وإظهار ToolTip. لا تستخدمها لشيء آخر.
    -->

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- COLORS -->
        <!-- ===================================================== -->
        <Color x:Key="PrimaryColor">#176B4D</Color>
        <Color x:Key="PrimaryDarkColor">#10543C</Color>
        <Color x:Key="PrimaryLightColor">#E8F5EF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="DangerColor">#D92D20</Color>

        <!-- ===================================================== -->
        <!-- BRUSHES -->
        <!-- ===================================================== -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#17202A"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2B3"/>
        <SolidColorBrush x:Key="BorderLineBrush" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10543C" Offset="0"/>
            <GradientStop Color="#176B4D" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===================================================== -->
        <!-- ICONS (Geometry 24x24 - Stroke based) -->
        <!-- ===================================================== -->
        <Geometry x:Key="Icon.Menu">M3,6H21 M3,12H21 M3,18H21</Geometry>
        <Geometry x:Key="Icon.Pharmacy">M9,3H15V9H21V15H15V21H9V15H3V9H9Z</Geometry>
        <Geometry x:Key="Icon.User">M12,11A4,4 0 1,0 12,3A4,4 0 0,0 12,11Z M4,21C4,16.5 7.5,14 12,14C16.5,14 20,16.5 20,21</Geometry>
        <Geometry x:Key="Icon.Logout">M10,4H5V20H10 M15,8L19,12L15,16 M19,12H9</Geometry>
        <Geometry x:Key="Icon.Update">M20,12A8,8 0 1,1 17.7,6.3 M20,4V8H16</Geometry>

        <Geometry x:Key="Icon.Dashboard">M3,3H10V10H3Z M14,3H21V10H14Z M3,14H10V21H3Z M14,14H21V21H14Z</Geometry>
        <Geometry x:Key="Icon.Reports">M4,20V4 M4,20H20 M8,16V11 M12,16V7 M16,16V13</Geometry>
        <Geometry x:Key="Icon.SalesSummary">M3,17L9,11L13,15L21,6 M15,6H21V12</Geometry>
        <Geometry x:Key="Icon.StockMovement">M7,4V20 M3,8L7,4L11,8 M17,20V4 M13,16L17,20L21,16</Geometry>
        <Geometry x:Key="Icon.Balance">M12,3V21 M5,21H19 M4,7H20 M4,7L2,13A3,3 0 0,0 8,13L6,7 M20,7L18,13A3,3 0 0,0 24,13L22,7</Geometry>
        <Geometry x:Key="Icon.Income">M12,21A9,9 0 1,0 12,3A9,9 0 0,0 12,21Z M12,7V17 M9.5,9.5C9.5,8.5 10.5,8 12,8C13.5,8 14.5,8.7 14.5,9.8C14.5,12 9.5,11.5 9.5,14.2C9.5,15.3 10.5,16 12,16C13.5,16 14.5,15.5 14.5,14.5</Geometry>

        <Geometry x:Key="Icon.Pos">M5,3H19V9H5Z M4,9H20V21H4Z M8,13H10 M12,13H16 M8,17H16</Geometry>
        <Geometry x:Key="Icon.Invoice">M6,3H14L19,8V21H6Z M14,3V8H19 M9,13H16 M9,17H16</Geometry>
        <Geometry x:Key="Icon.Items">M12,3L20,7.5V16.5L12,21L4,16.5V7.5Z M4,7.5L12,12L20,7.5 M12,12V21</Geometry>
        <Geometry x:Key="Icon.Stock">M3,10L12,4L21,10V20H3Z M8,20V14H16V20</Geometry>
        <Geometry x:Key="Icon.List">M8,6H21 M8,12H21 M8,18H21 M3,6H4 M3,12H4 M3,18H4</Geometry>

        <Geometry x:Key="Icon.Supplier">M2,6H14V16H2Z M14,9H18L21,12V16H14Z M6.5,18.5A1.5,1.5 0 1,0 6.5,15.5A1.5,1.5 0 0,0 6.5,18.5Z M17.5,18.5A1.5,1.5 0 1,0 17.5,15.5A1.5,1.5 0 0,0 17.5,18.5Z</Geometry>
        <Geometry x:Key="Icon.PurchaseOrder">M8,4H16V7H8Z M6,5.5H5V21H19V5.5H18 M9,12H15 M9,16H15</Geometry>
        <Geometry x:Key="Icon.GoodsReceipt">M4,14V20H20V14 M12,3V15 M7,10L12,15L17,10</Geometry>
        <Geometry x:Key="Icon.Cart">M3,4H6L8,15H18L20,7H7 M10,20H10.01 M17,20H17.01</Geometry>

        <Geometry x:Key="Icon.Doctor">M12,9A3.5,3.5 0 1,0 12,2A3.5,3.5 0 0,0 12,9Z M5,21C5,16.5 8,13.5 12,13.5C16,13.5 19,16.5 19,21 M12,16V20 M10,18H14</Geometry>
        <Geometry x:Key="Icon.Prescription">M6,3H14L19,8V21H6Z M14,3V8H19 M12.5,12V18 M9.5,15H15.5</Geometry>

        <Geometry x:Key="Icon.Building">M4,21V6L12,3L20,6V21 M4,21H20 M9,10H9.01 M15,10H15.01 M9,14H9.01 M15,14H15.01 M10,21V17H14V21</Geometry>
        <Geometry x:Key="Icon.Shield">M12,3L20,6V12C20,16.5 16.5,19.5 12,21C7.5,19.5 4,16.5 4,12V6Z M8.5,12L11,14.5L15.5,9.5</Geometry>
        <Geometry x:Key="Icon.Claim">M6,3H14L19,8V21H6Z M14,3V8H19 M9,14L11.5,16.5L15.5,12</Geometry>

        <Geometry x:Key="Icon.Accounts">M5,4H11V9H5Z M13,4H19V9H13Z M13,15H19V20H13Z M8,9V17.5H13</Geometry>
        <Geometry x:Key="Icon.Journal">M5,4H17A2,2 0 0,1 19,6V20H7A2,2 0 0,1 5,18Z M5,18A2,2 0 0,1 7,16H19 M9,8H15</Geometry>
        <Geometry x:Key="Icon.Bank">M3,9L12,4L21,9 M5,10V17 M10,10V17 M14,10V17 M19,10V17 M3,20H21</Geometry>
        <Geometry x:Key="Icon.Folder">M3,6H10L12,8H21V19H3Z</Geometry>
        <Geometry x:Key="Icon.Expense">M3,6H21V18H3Z M12,15A3,3 0 1,0 12,9A3,3 0 0,0 12,15Z M6,12H6.01 M18,12H18.01</Geometry>
        <Geometry x:Key="Icon.Swap">M4,8H20 M16,4L20,8L16,12 M20,16H4 M8,12L4,16L8,20</Geometry>

        <Geometry x:Key="Icon.Clock">M12,21A9,9 0 1,0 12,3A9,9 0 0,0 12,21Z M12,7V12L15.5,14</Geometry>
        <Geometry x:Key="Icon.Attendance">M4,5H20V21H4Z M4,10H20 M8,3V7 M16,3V7 M9,15L11.5,17.5L15.5,13</Geometry>
        <Geometry x:Key="Icon.Percent">M19,5L5,19 M7,9A2,2 0 1,0 7,5A2,2 0 0,0 7,9Z M17,19A2,2 0 1,0 17,15A2,2 0 0,0 17,19Z</Geometry>
        <Geometry x:Key="Icon.Payroll">M4,7H19V20H4Z M4,7L16,3V7 M19,12H15V16H19</Geometry>

        <Geometry x:Key="Icon.Branch">M12,21C12,21 5,14.5 5,10A7,7 0 0,1 19,10C19,14.5 12,21 12,21Z M12,12.5A2.5,2.5 0 1,0 12,7.5A2.5,2.5 0 0,0 12,12.5Z</Geometry>
        <Geometry x:Key="Icon.Key">M8,15A4,4 0 1,0 8,7A4,4 0 0,0 8,15Z M11.5,12H21 M18,12V16 M15,12V15</Geometry>
        <Geometry x:Key="Icon.Backup">M4,6C4,4.3 7.6,3 12,3C16.4,3 20,4.3 20,6C20,7.7 16.4,9 12,9C7.6,9 4,7.7 4,6Z M4,6V18C4,19.7 7.6,21 12,21C16.4,21 20,19.7 20,18V6 M4,12C4,13.7 7.6,15 12,15C16.4,15 20,13.7 20,12</Geometry>
        <Geometry x:Key="Icon.License">M4,4H20V15H4Z M8,8H16 M8,11H13 M9,15V21L12,19L15,21V15</Geometry>

        <!-- ===================================================== -->
        <!-- ICON STYLES -->
        <!-- ===================================================== -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================== -->
        <!-- TEXT STYLES -->
        <!-- ===================================================== -->
        <Style x:Key="NavSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="22,18,22,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- فاصل رفيع يظهر فقط عند طي القائمة بدل عنوان القسم -->
        <Style x:Key="NavCollapsedDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="18,10"/>
            <Setter Property="Background" Value="{StaticResource BorderLineBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================================================== -->
        <!-- SIDEBAR NAV ITEM (RadioButton => Active state بدون ViewModel) -->
        <!-- ===================================================== -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
            <Setter Property="ToolTipService.Placement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Height="42"
                                Margin="10,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- المؤشر الجانبي للعنصر النشط -->
                                <Border x:Name="Indicator"
                                        Grid.Column="0"
                                        Width="4"
                                        Margin="0,9"
                                        CornerRadius="2"
                                        Background="{StaticResource PrimaryBrush}"
                                        Visibility="Collapsed"/>

                                <StackPanel x:Name="ContentHost"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0">
                                    <Path Data="{TemplateBinding Tag}"
                                          Style="{StaticResource IconPath}"
                                          Stroke="{TemplateBinding Foreground}"/>
                                    <TextBlock x:Name="Label"
                                               Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ContentHost" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="ContentHost" Property="Margin" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===================================================== -->
        <!-- COLLAPSE TOGGLE -->
        <!-- ===================================================== -->
        <Style x:Key="CollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Height="40"
                                Margin="10,0">
                            <StackPanel x:Name="Host"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0">
                                <Path Data="{StaticResource Icon.Menu}"
                                      Style="{StaticResource IconPath}"
                                      Stroke="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="Label"
                                           Text="القائمة"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Host" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="Host" Property="Margin" Value="0"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================================================== -->
        <!-- HEADER BUTTONS -->
        <!-- ===================================================== -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3DFFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#3DFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B42318"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================================================== -->
        <!-- THIN SCROLLBAR -->
        <!-- ===================================================== -->
        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#D0D5DD"
                                                        CornerRadius="3"
                                                        Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- اسم الصيدلية (يمين) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="#26FFFFFF">
                        <Path Data="{StaticResource Icon.Pharmacy}"
                              Style="{StaticResource IconPath}"
                              Stroke="White"
                              HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="صيدلية النخيل"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="نظام إدارة الصيدليات"
                                   FontSize="11"
                                   Foreground="#BFE3D2"/>
                    </StackPanel>

                </StackPanel>

                <!-- مساحة وسطية -->
                <Grid Grid.Column="1"/>

                <!-- المستخدم + الأزرار (يسار) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- بطاقة المستخدم -->
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#26FFFFFF">
                        <Path Data="{StaticResource Icon.User}"
                              Style="{StaticResource HeaderIcon}"
                              Stroke="White"
                              HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding WelcomeMessage}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RoleAndBranch}"
                                   Foreground="#D8EFE3"
                                   FontSize="11"/>
                    </StackPanel>

                    <Rectangle Width="1"
                               Height="28"
                               Fill="#33FFFFFF"
                               Margin="18,0"/>

                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource HeaderButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Update}"
                                  Style="{StaticResource HeaderIcon}"
                                  Stroke="White"/>
                            <TextBlock Text="التحقق من التحديثات"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LogoutCommand}"
                            Style="{StaticResource HeaderDangerButtonStyle}"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logout}"
                                  Style="{StaticResource HeaderIcon}"
                                  Stroke="White"/>
                            <TextBlock Text="تسجيل الخروج"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- BODY -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <!-- القائمة الجانبية (يمين بسبب RTL) -->
                <ColumnDefinition Width="Auto"/>
                <!-- المحتوى -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- SIDEBAR -->
            <!-- ===================================================== -->

            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="72"
                                                             Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="240"
                                                             Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel LastChildFill="True">

                    <!-- زر الطي / التوسيع -->
                    <Grid DockPanel.Dock="Top"
                          Height="56">
                        <ToggleButton x:Name="CollapseToggle"
