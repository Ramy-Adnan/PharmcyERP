                                         ToolTip="النسخ الاحتياطي والاستعادة"
                                         Tag="{StaticResource Icon.Backup}"
                                         Command="{Binding NavigateToBackupCommand}"
                                         Visibility="{Binding CanManageBackup, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="الترخيص"
                                         ToolTip="الترخيص"
                                         Tag="{StaticResource Icon.License}"
                                         Command="{Binding NavigateToLicenseCommand}"
                                         Visibility="{Binding CanManageLicense, Converter={StaticResource BoolToVisibilityConverter}}"/>

