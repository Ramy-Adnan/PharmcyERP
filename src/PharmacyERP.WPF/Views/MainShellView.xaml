            <Grid Grid.Column="1"
                  Background="{StaticResource BackgroundBrush}">

                <!-- الصفحة الحالية -->
                <ContentControl Content="{Binding CurrentView}"/>

                <!-- رسالة البداية -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="40,32"
                        MaxWidth="520"
                        Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">

                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="64"
                                Height="64"
                                CornerRadius="32"
                                Background="{StaticResource PrimaryLightBrush}"
                                HorizontalAlignment="Center">
                            <Path Data="{StaticResource Icon.Pharmacy}"
                                  Style="{StaticResource IconPath}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="مرحباً بك في نظام إدارة الصيدليات"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,18,0,6"/>

                        <TextBlock Text="اختر أحد الموديولات من القائمة الجانبية للبدء."
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextAlignment="Center"
