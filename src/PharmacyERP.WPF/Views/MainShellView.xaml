                                         Tag="{StaticResource Icon.Swap}"
                                         Command="{Binding NavigateToReceiptsAndPaymentsCommand}"
                                         Visibility="{Binding CanManageReceiptsAndPayments, Converter={StaticResource BoolToVisibilityConverter}}"/>


                            <!-- ============================= -->
                            <!-- HR -->
                            <!-- ============================= -->

                            <StackPanel>
                                <TextBlock Text="الموارد البشرية" Style="{StaticResource NavSectionTitle}"/>
                                <Border Style="{StaticResource NavCollapsedDivider}"/>
                            </StackPanel>

                            <RadioButton Style="{StaticResource NavItemStyle}"
                                         GroupName="MainNav"
                                         Content="الموظفون"
                                         ToolTip="الموظفون"
                                         Tag="{StaticResource Icon.User}"
                                         Command="{Binding NavigateToEmployeesCommand}"
                                         Visibility="{Binding CanManageHrEmployees, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <RadioButton Style="{StaticResource NavItemStyle}"
