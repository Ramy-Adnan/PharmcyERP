<UserControl x:Class="PharmacyERP.WPF.Views.Sales.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="العملاء" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="عميل جديد" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddCustomerCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditCustomerCommand}"/>
                    <Button Content="تفعيل / تعطيل" Padding="12,6" Command="{Binding ToggleStatusCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="90"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
