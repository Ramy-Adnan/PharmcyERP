<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Sales.SalesInvoiceDetailDialog" Title="تفاصيل الفاتورة" Height="690" Width="820" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <UniformGrid Columns="4" Rows="2">
                    <StackPanel Margin="0,0,8,6">
                        <TextBlock Text="رقم الفاتورة" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,6">
                        <TextBlock Text="العميل" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.CustomerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,6">
                        <TextBlock Text="الكاشير" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.CashierName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="الحالة" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="التاريخ والوقت" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.SaleAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="طريقة الدفع" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.PaymentMethod}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="الإجمالي" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.TotalAmount, StringFormat=N2}" FontWeight="Bold" Foreground="#1F6F50" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding Quantity}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="تم إرجاعه" Binding="{Binding QuantityReturned}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="قابل للإرجاع" Binding="{Binding QuantityReturnable}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="كمية الإرجاع الآن" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="3" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="سبب الإرجاع" Margin="0,0,0,4" Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10" Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="طباعة وصل 80mm" Command="{Binding PrintCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="تسجيل الإرجاع" Command="{Binding ProcessReturnCommand}" Margin="0,0,8,0" Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                        <Button Content="إلغاء الفاتورة كاملة" Command="{Binding VoidInvoiceCommand}" Margin="0,0,8,0" Visibility="{Binding CanVoid, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                        <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
