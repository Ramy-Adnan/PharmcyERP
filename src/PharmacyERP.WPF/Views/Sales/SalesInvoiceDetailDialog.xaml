<Window x:Class="PharmacyERP.WPF.Views.Sales.SalesInvoiceDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الفاتورة" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
            <UniformGrid Columns="4" Rows="2">
                <StackPanel Margin="0,0,8,6">
                    <TextBlock Text="رقم الفاتورة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,6">
                    <TextBlock Text="العميل" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.CustomerName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,6">
                    <TextBlock Text="الكاشير" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.CashierName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Status}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="التاريخ والوقت" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.SaleAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="طريقة الدفع" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.PaymentMethod}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الإجمالي" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.TotalAmount, StringFormat=N2}" FontWeight="Bold" Foreground="#1F6F50"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      RowHeight="32" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding Quantity}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="تم إرجاعه" Binding="{Binding QuantityReturned}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="قابل للإرجاع" Binding="{Binding QuantityReturnable}" Width="95" IsReadOnly="True"/>
                    <DataGridTextColumn Header="كمية الإرجاع الآن" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="سبب الإرجاع" Margin="0,0,0,4"
                       Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"
                     Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="طباعة وصل 80mm" Command="{Binding PrintCommand}" Padding="12,8" Margin="0,0,8,0"/>
                <Button Content="تسجيل الإرجاع" Padding="16,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                        Command="{Binding ProcessReturnCommand}" Margin="0,0,8,0"
                        Visibility="{Binding CanProcessReturns, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="إلغاء الفاتورة كاملة" Padding="16,8" Foreground="#DC2626"
                        Command="{Binding VoidInvoiceCommand}" Margin="0,0,8,0"
                        Visibility="{Binding CanVoid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="إغلاق" Padding="16,8" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
