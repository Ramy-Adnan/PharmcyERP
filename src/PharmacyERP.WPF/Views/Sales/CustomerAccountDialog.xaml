<Window x:Class="PharmacyERP.WPF.Views.Sales.CustomerAccountDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="كشف ديون العميل وتسديداته" Width="980" Height="720" MinWidth="800" MinHeight="600"
 WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F1F5F9">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding CustomerName}" FontSize="24" FontWeight="Bold"/>
   <TextBlock Text="{Binding OutstandingAmount, StringFormat='الدين المتبقي: {0:N2}'}" FontSize="22" Foreground="#B45309"/></StackPanel>
   <Button Content="تحديث الكشف" Command="{Binding RefreshCommand}" Padding="14,8" HorizontalAlignment="Left"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <GroupBox Header="الفواتير الآجلة — اختر الفاتورة المراد تسديدها">
    <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="الفاتورة" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="100"/><DataGridTextColumn Header="التاريخ" Binding="{Binding SaleAtUtc, StringFormat=yyyy-MM-dd}" Width="95"/><DataGridTextColumn Header="القيمة" Binding="{Binding InvoiceAmount, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="مرتجع" Binding="{Binding ReturnedAmount, StringFormat=N2}" Width="75"/><DataGridTextColumn Header="المسدد" Binding="{Binding PaidAmount, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="المتبقي" Binding="{Binding OutstandingAmount, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="الحالة" Binding="{Binding PaymentStatus}" Width="95"/></DataGrid.Columns>
    </DataGrid>
   </GroupBox>
   <StackPanel Grid.Row="1" Margin="0,12" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
    <WrapPanel><TextBlock Text="مبلغ التسديد" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox x:Name="AmountBox" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="130" Padding="8"/>
     <ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding PaymentMethod}" Width="110" Padding="7" Margin="8,0"/>
     <Button Content="تسجيل قبض وتسديد" Click="PayClicked" Padding="15,8" Background="#0F766E" Foreground="White"/>
     <Button Content="تصحيح قيود الآجل القديمة" Command="{Binding ReconcileCommand}" Padding="10,8" Margin="10,0"/>
    </WrapPanel>
    <TextBlock Text="لا تسجل تسديد الدين من شاشة القبض العام؛ هذا التسديد مرتبط بالفاتورة ويخفض ذمة العميل." Foreground="#64748B" Margin="0,7,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <GroupBox Grid.Row="2" Header="سجل التسديدات">
    <DataGrid ItemsSource="{Binding Payments}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="إيصال القبض" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="*"/><DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="الدفع" Binding="{Binding Method}" Width="80"/></DataGrid.Columns>
    </DataGrid>
   </GroupBox>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Message}" Margin="0,12,0,0" Foreground="#0F766E" TextWrapping="Wrap"/>
 </Grid>
</Window>
