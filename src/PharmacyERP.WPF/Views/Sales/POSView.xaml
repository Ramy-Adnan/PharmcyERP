<UserControl x:Class="PharmacyERP.WPF.Views.Sales.POSView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F3F5F9">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17233B"/>
  <SolidColorBrush x:Key="Muted" Color="#7B879D"/>
  <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/><Setter Property="BorderBrush" Value="#E6EBF2"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ButtonBase" TargetType="Button">
   <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
  <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#0D9488"/><Setter TargetName="InputBorder" Property="Background" Value="White"/></Trigger>
     <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="PaymentChip" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6,12"/><Setter Property="Foreground" Value="#6C7890"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chip" Background="#F8FAFC" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <StackPanel><ContentPresenter HorizontalAlignment="Center"/><Border x:Name="Dot" Background="#D9E0EA" Width="5" Height="5" CornerRadius="3" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#ECFDF5"/><Setter TargetName="Chip" Property="BorderBrush" Value="#0D9488"/><Setter TargetName="Dot" Property="Background" Value="#0D9488"/><Setter Property="Foreground" Value="#0F766E"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="MoneyText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0F766E"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="#7B879D"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F0F3F8"/><Setter Property="MinHeight" Value="66"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F0FDFA"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Brand and cashier identity -->
  <Border CornerRadius="18" Padding="20,14">
   <Border.Background><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#15213A" Offset="0"/><GradientStop Color="#263A58" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" Background="#29465A" CornerRadius="13" Margin="0,0,14,0"><Path Data="M 6,16 L 26,16 M 16,6 L 16,26" Stroke="#5EEAD4" StrokeThickness="4" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1"><TextBlock Text="نقطة البيع" FontSize="23" FontWeight="Bold" Foreground="White"/><TextBlock Text="PHARMACY ERP  /  CHECKOUT" FontSize="10" Foreground="#96ACC7" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding CashierName}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="F9  مسح الباركود     •     F12  بيع وطباعة" Foreground="#96ACC7" FontSize="11" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Opacity" Value="0.65"/></DataTrigger><DataTrigger Binding="{Binding CheckoutUncertain}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Scanner station -->
    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><DockPanel Margin="0,0,0,9"><TextBlock Text="امسح المنتج أو ابحث عنه" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="كرر المسح لزيادة الكمية" Style="{StaticResource Caption}" HorizontalAlignment="Left"/></DockPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#E8F6F3" CornerRadius="10" Margin="0,0,8,0"><Path Stroke="#0D9488" StrokeThickness="2" Data="M 0,0 L 0,22 M 4,0 L 4,22 M 10,0 L 10,22 M 13,0 L 13,22 M 18,0 L 18,22 M 22,0 L 22,22" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBox Grid.Column="1" x:Name="ScanBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="ScanTextChanged" PreviewKeyDown="ScanKeyDown" FlowDirection="LeftToRight" FontSize="21" Padding="12,10"/>
       </Grid>
      </StackPanel><Button Grid.Column="1" Content="بحث" Command="{Binding SearchCommand}" Background="#0D9488" Foreground="White" Padding="20,12" Margin="12,27,0,0"/>
     </Grid>
    </Border>
    <!-- Manual search results stay out of the scanner workflow -->
    <Border Grid.Row="1" Padding="12" Margin="0,0,0,14">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SearchResults.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button DockPanel.Dock="Bottom" Content="إضافة الصنف المحدد إلى السلة" Command="{Binding AddToCartCommand}" Margin="0,9,0,0"/>
      <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="145" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None">
       <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddToCartCommand}"/></DataGrid.InputBindings>
       <DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" Width="*"/><DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" ElementStyle="{StaticResource CellText}" Width="130"/><DataGridTextColumn Header="السعر" Binding="{Binding DefaultSalePrice, StringFormat=N2}" ElementStyle="{StaticResource MoneyText}" Width="90"/><DataGridTextColumn Header="المتوفر" Binding="{Binding AvailableQuantity}" ElementStyle="{StaticResource CellText}" Width="70"/></DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <!-- Cart fills the remaining height; no fixed-height scrolling trap -->
    <Border Grid.Row="2" Style="{StaticResource Card}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="18,16"><StackPanel Orientation="Horizontal"><TextBlock Text="سلة المشتريات" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Background="#E8F6F3" CornerRadius="8" Padding="9,4" Margin="10,0,0,0"><TextBlock Text="{Binding ItemCount, StringFormat='{}{0} قطعة'}" Foreground="#0F766E" FontWeight="SemiBold"/></Border></StackPanel>
       <Button Content="تفريغ السلة" Command="{Binding ClearCartCommand}" Foreground="#BE4056" Background="#FFF1F3" Padding="10,7" HorizontalAlignment="Left"/>
      </DockPanel>
      <Grid Grid.Row="1">
       <DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column" EnableRowVirtualization="True" Background="White" Margin="1,0">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="المنتج" Width="*" MinWidth="135" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="12,9" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Code}" Style="{StaticResource Caption}"/><TextBlock Text=" · " Style="{StaticResource Caption}"/><TextBlock Text="{Binding UnitOfMeasureName}" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="الكمية" Width="128"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
           <Button Content="+" ToolTip="زيادة الكمية" Style="{StaticResource MiniButton}" Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="44" Padding="3,5" FontSize="15" TextAlignment="Center" Margin="3,0"/>
           <Button Content="−" ToolTip="تقليل الكمية" Style="{StaticResource MiniButton}" Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}" Width="88"/>
         <DataGridTextColumn Header="خصم" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}" Width="68"/>
         <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" ElementStyle="{StaticResource MoneyText}" Width="104" IsReadOnly="True"/>
         <DataGridTemplateColumn Width="44" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Button Content="×" Style="{StaticResource MiniButton}" Background="Transparent" Foreground="#AFB7C7" ToolTip="حذف الصنف" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Center"/>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,45,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CartLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Border Background="#F1F5F9" Width="76" Height="76" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,17"><Path Data="M 2,2 L 8,2 L 13,25 L 35,25 L 40,9 L 10,9 M 15,31 L 17,31 M 31,31 L 33,31" Stroke="#95A3B9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="40" Height="35" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="ابدأ بأول منتج" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="امسح الباركود، وسنضيف الصنف هنا" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="18,12"><DockPanel><TextBlock Text="{Binding CartLines.Count, StringFormat='{}{0} أصناف في السلة'}" Style="{StaticResource Caption}"/><TextBlock Text="يمكنك تعديل السعر والكمية والخصم مباشرة" Style="{StaticResource Caption}" HorizontalAlignment="Left"/></DockPanel></Border>
     </Grid>
    </Border>
   </Grid>
   <!-- Payment station: detail scrolls while the final action remains visible -->
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
    <DockPanel LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="الدفع" FontSize="20" FontWeight="Bold"/><Border Background="#EEF2FF" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="فاتورة جديدة" FontSize="11" Foreground="#6366A8"/></Border></DockPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Border BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
       <StackPanel>
        <DockPanel><TextBlock Text="قيمة الأصناف" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SubTotal, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/></DockPanel>
        <DockPanel Margin="0,7,0,0"><TextBlock Text="الضريبة" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TaxAmount, StringFormat=N2}" HorizontalAlignment="Left"/></DockPanel>
        <DockPanel Margin="0,7,0,0"><TextBlock Text="إجمالي الخصم" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CartDiscount, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#BE4056"/></DockPanel>
        <Border Background="#17233B" CornerRadius="14" Padding="16,12" Margin="0,14,0,12"><StackPanel><TextBlock Text="إجمالي الفاتورة" Foreground="#A7B6CD" FontSize="12"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" MaxHeight="48"><TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="37" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/></Viewbox></StackPanel></Border>
        <DockPanel Margin="0,0,0,12" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="المتبقي على العميل" Foreground="#B45309" FontWeight="SemiBold"/><TextBlock Text="{Binding CreditRemaining, StringFormat=N2}" Foreground="#B45309" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left"/></DockPanel>
        <Button Click="CheckoutClicked" Background="#0D9488" Foreground="White" Padding="14,15" FontSize="17" FontWeight="SemiBold"><DockPanel><TextBlock Text="بيع وطباعة" Foreground="White" FontSize="17" FontWeight="SemiBold"/><Border Background="#238F84" CornerRadius="6" Padding="7,3" Margin="18,0,0,0"><TextBlock Text="F12" Foreground="#D6FFF6" FontSize="11"/></Border></DockPanel></Button>
        <Button Content="إعادة طباعة آخر وصل" Command="{Binding ReprintCommand}" Background="Transparent" Foreground="#7B879D" Padding="8" Margin="0,5,0,0" FontSize="12"/>
        <TextBlock Text="الطابعة الافتراضية · وصل حراري 80mm" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <UniformGrid Columns="3" Margin="-3,0,-3,12">
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCash, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="نقدي" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCard, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="بطاقة" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCredit, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="آجل" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
       </UniformGrid>
       <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,15"/>
       <TextBlock Text="العميل" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomer}" IsTextSearchEnabled="True"/>
       <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,12,0,0">
        <DockPanel><TextBlock Text="الرصيد السابق" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerDebt, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#B45309"/></DockPanel>
        <Border Background="#FFFBEB" CornerRadius="9" Padding="10" Margin="0,10,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasCreditCustomer}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="اختر عميلاً مسجلاً لحفظ الدين باسمه" Foreground="#B45309" FontSize="12" TextWrapping="Wrap"/></Border>
        <TextBlock Text="المبلغ المستلم الآن" FontWeight="SemiBold" Margin="0,16,0,7"/>
        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" FontSize="23" Padding="12" FlowDirection="LeftToRight"/>
        <DockPanel Margin="0,7,0,0"><TextBlock Text="دفعة نقدية اختيارية" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="استلام كامل المبلغ" Command="{Binding PayAllCreditCommand}" Background="Transparent" Foreground="#0F766E" Padding="0,3" FontSize="11" HorizontalAlignment="Left"/></DockPanel>
        <DockPanel Margin="0,12,0,0"><TextBlock Text="رصيد العميل بعد البيع" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerBalanceAfterSale, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/></DockPanel>
       </StackPanel>
       <Expander Header="الخصم والوصفة الطبية" Margin="0,18,0,0">
        <Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding HasUnresolvedPrescriptionRequirement}" Value="True"><Setter Property="IsExpanded" Value="True"/></DataTrigger></Style.Triggers></Style></Expander.Style>
        <StackPanel Margin="0,10,0,0"><TextBlock Text="خصم إضافي على الفاتورة" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Text="الوصفة الطبية المرتبطة" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding FillablePrescriptions}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedPrescription}"/>
         <TextBlock Text="يلزم ربط وصفة لهذا الصنف قبل البيع" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasUnresolvedPrescriptionRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <Button Content="التحقق من البيع السابق بعد إعادة الاتصال" Command="{Binding ResolveCheckoutCommand}" Visibility="{Binding CheckoutUncertain, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right"/>
   <Border Background="#E8F6F3" CornerRadius="10" Padding="12,9" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap"/></Border>
   <Border Background="#FFF1F3" CornerRadius="10" Padding="12,9" Margin="0,5,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#BE4056" TextWrapping="Wrap"/></Border>
   <TextBlock Text="جارٍ حفظ العملية…" Style="{StaticResource Caption}" Margin="4,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </StackPanel>
 </Grid>
</UserControl>
