<UserControl x:Class="PharmacyERP.WPF.Views.Sales.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search + cart -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="نقطة البيع" FontSize="20" FontWeight="Bold" Foreground="#1F2937"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Padding="8" FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Row="0" Grid.Column="2" Content="بحث / مسح باركود" Padding="14,8"
                        Background="#1F6F50" Foreground="White" BorderThickness="0" Command="{Binding SearchCommand}"/>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="30" FontSize="12">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddToCartCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding DefaultSalePrice, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="المتوفر" Binding="{Binding AvailableQuantity}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="إضافة للسلة" Padding="12,6" Margin="0,0,8,0" Background="#1F6F50" Foreground="White" BorderThickness="0"
                            Command="{Binding AddToCartCommand}"/>
                    <Button Content="حذف من السلة" Padding="12,6" Margin="0,0,8,0" Foreground="#DC2626" Command="{Binding RemoveLineCommand}"/>
                    <Button Content="تفريغ السلة" Padding="12,6" Command="{Binding ClearCartCommand}"/>
                </StackPanel>

                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="13" Height="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="وصفة" Binding="{Binding RequiresPrescription}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="الضريبة %" Binding="{Binding TaxRatePercent}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="خصم" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="95" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Right: customer, payment, totals, checkout -->
        <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Margin="16">
                <TextBlock Text="تفاصيل الدفع" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="العميل" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomer}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الوصفة الطبية المرتبطة (إن وجدت)" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding FillablePrescriptions}" SelectedItem="{Binding SelectedPrescription}" Padding="6" Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} — {1:yyyy-MM-dd}">
                                        <Binding Path="Number"/>
                                        <Binding Path="PrescriptionDate"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="⚠ يوجد صنف في السلة يتطلب وصفة طبية — الرجاء ربط الوصفة المناسبة."
                           Foreground="#D97706" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding HasUnresolvedPrescriptionRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="طريقة الدفع" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="خصم إضافي على الفاتورة" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,6">
                    <TextBlock Text="المجموع الفرعي" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SubTotal, StringFormat=N2}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="الضريبة" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TaxAmount, StringFormat=N2}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="الإجمالي النهائي" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontWeight="Bold" FontSize="16" Foreground="#1F6F50" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Text="المبلغ المستلم (نقداً)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" FontSize="14"/>

                <Grid Margin="0,0,0,16">
                    <TextBlock Text="الباقي للعميل" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ChangeDue, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                </Grid>

                <Button Content="إتمام البيع" Padding="0,14" Background="#1F6F50" Foreground="White" BorderThickness="0"
                        FontSize="16" FontWeight="Bold" Command="{Binding CheckoutCommand}" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding SuccessMessage}" Foreground="#1F6F50" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
