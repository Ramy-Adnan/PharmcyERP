<UserControl x:Class="PharmacyERP.WPF.Views.Sales.POSView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F3F6FB" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="LayoutSizeChanged">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17233B"/>
  <SolidColorBrush x:Key="Muted" Color="#7B879D"/>
  <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#E6EBF2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#15233D" BlurRadius="18" ShadowDepth="3" Opacity="0.045"/></Setter.Value></Setter></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ButtonBase" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
  <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#0D9488"/><Setter TargetName="InputBorder" Property="Background" Value="White"/></Trigger>
     <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="PaymentChip" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6,12"/><Setter Property="Foreground" Value="#6C7890"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chip" Background="#F8FAFC" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <StackPanel><ContentPresenter HorizontalAlignment="Center"/><Border x:Name="Dot" Background="#D9E0EA" Width="5" Height="5" CornerRadius="3" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#ECFDF5"/><Setter TargetName="Chip" Property="BorderBrush" Value="#0D9488"/><Setter TargetName="Dot" Property="Background" Value="#0D9488"/><Setter Property="Foreground" Value="#0F766E"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="MoneyText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0F766E"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="#7B879D"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F0F3F8"/><Setter Property="MinHeight" Value="66"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F5FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5F4EF"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CategoryTile" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8,12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Tile" CornerRadius="12" Background="{Binding Background}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
     <StackPanel><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{Binding Accent}" HorizontalAlignment="Center" Margin="0,0,0,9"/>
      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MinHeight="32" VerticalAlignment="Center"/>
     </StackPanel>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Accent}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>
 <Grid Margin="16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- The native window title bar and controls remain in MainShellView. -->
  <Border Style="{StaticResource Card}" Padding="18,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="46" Height="46" Background="#E7F7F1" CornerRadius="13" Margin="0,0,12,0"><Path Data="M 6,16 L 26,16 M 16,6 L 16,26" Stroke="#159879" StrokeThickness="4" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="نقطة البيع" FontSize="23" FontWeight="Bold"/><TextBlock Text="الصيدلية · العناية والجمال" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
     <TextBlock Text="{Binding CashierName, StringFormat='المحاسب: {0}'}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" FlowDirection="LeftToRight" Foreground="#159879"/><TextBlock Text="  ·  " Style="{StaticResource Caption}"/><TextBlock x:Name="DateText" Style="{StaticResource Caption}"/></StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="BodyLayout" Grid.Row="2">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Opacity" Value="0.65"/></DataTrigger><DataTrigger Binding="{Binding CheckoutUncertain}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="186"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ActionColumn" Width="278"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- Actual inventory categories, no mock products or fixed package assumptions. -->
   <Border x:Name="CategoryPanel" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10,16">
    <DockPanel><StackPanel x:Name="CategoryHeading" DockPanel.Dock="Top" Margin="8,0,0,12"><TextBlock Text="التصنيفات" FontSize="16" FontWeight="Bold"/><TextBlock Text="تصفح الأصناف" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="CategoryItems" ItemsSource="{Binding Categories}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><RadioButton GroupName="Categories" Style="{StaticResource CategoryTile}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.BrowseCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Grid x:Name="InvoicePanel" Grid.Column="1" Grid.Row="1" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="امسح الباركود أو ابحث عن صنف" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#E7F7F1" CornerRadius="9" Margin="0,0,7,0"><Path Stroke="#159879" StrokeThickness="2" Data="M 0,0 L 0,22 M 4,0 L 4,22 M 10,0 L 10,22 M 13,0 L 13,22 M 18,0 L 18,22 M 22,0 L 22,22" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBox Grid.Column="1" x:Name="ScanBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="ScanTextChanged" PreviewKeyDown="ScanKeyDown" FlowDirection="LeftToRight" FontSize="20" Padding="12,9" ToolTip="الباركود أو اسم الصنف · F9" AutomationProperties.Name="الباركود أو اسم الصنف"/>
       </Grid>
      </StackPanel><Button Grid.Column="1" Content="بحث" Command="{Binding SearchCommand}" Background="#EAF1FF" Foreground="#3368C6" Padding="16,10" Margin="10,25,0,0"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Padding="10" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SearchResults.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><DockPanel DockPanel.Dock="Top" Margin="4,0,4,8"><Button DockPanel.Dock="Left" Content="×" Command="{Binding CloseResultsCommand}" Style="{StaticResource MiniButton}" ToolTip="إغلاق نتائج البحث"/><TextBlock Text="{Binding ResultsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      <Button DockPanel.Dock="Bottom" Content="إضافة الصنف المحدد" Command="{Binding AddToCartCommand}" Background="#E7F7F1" Foreground="#128367" Padding="10,8" Margin="0,8,0,0"/>
      <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="152" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="White" AlternatingRowBackground="#F7F9FC">
       <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddToCartCommand}"/></DataGrid.InputBindings>
       <DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding DisplayName}" ElementStyle="{StaticResource CellText}" Width="*" MinWidth="130"/><DataGridTextColumn Header="سعر الوحدة" Binding="{Binding DefaultSalePrice, StringFormat=N2}" ElementStyle="{StaticResource MoneyText}" Width="90"/><DataGridTextColumn Header="المتوفر" Binding="{Binding StockDisplay}" ElementStyle="{StaticResource CellText}" Width="95"/></DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="14,14"><Button DockPanel.Dock="Left" Content="وحدة أخرى +" Command="{Binding AddOtherUnitCommand}" Padding="9,7" FontSize="11"/><StackPanel Orientation="Horizontal"><TextBlock Text="الفاتورة الحالية" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><Border Background="#E7F7F1" CornerRadius="7" Padding="8,4" Margin="8,0,0,0"><TextBlock Text="{Binding ItemCount, StringFormat='{}{0} قطعة'}" Foreground="#128367" FontSize="11" FontWeight="SemiBold"/></Border></StackPanel></DockPanel>
      <Grid Grid.Row="1">
       <DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="1,0">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="اسم الصنف" Width="*" MinWidth="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="12,9" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Code}" Style="{StaticResource Caption}"/><TextBlock Text=" · " Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedUnitName}" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="وحدة البيع" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="4" VerticalAlignment="Center">
           <ComboBox DropDownClosed="SaleUnitClosed" PreviewKeyDown="SaleUnitKeyDown" ItemsSource="{Binding SaleUnits}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSaleUnit, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
           <TextBlock Text="{Binding AvailableQuantity, StringFormat='متوفر: {0}'}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="الكمية" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
           <Button Content="+" ToolTip="زيادة الكمية" Style="{StaticResource MiniButton}" Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="44" Padding="3,5" FontSize="15" TextAlignment="Center" Margin="3,0"/>
           <Button Content="−" ToolTip="تقليل الكمية" Style="{StaticResource MiniButton}" Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}" Width="88"/>
         <DataGridTextColumn Header="خصم" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}" Width="60"/>
         <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" ElementStyle="{StaticResource MoneyText}" Width="104" IsReadOnly="True"/>
         <DataGridTemplateColumn Width="44" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Button Content="×" Style="{StaticResource MiniButton}" Background="Transparent" Foreground="#AFB7C7" ToolTip="حذف الصنف" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Center"/>
         </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,45,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CartLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Border Background="#F1F5F9" Width="76" Height="76" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,17"><Path Data="M 2,2 L 8,2 L 13,25 L 35,25 L 40,9 L 10,9 M 15,31 L 17,31 M 31,31 L 33,31" Stroke="#95A3B9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="40" Height="35" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="ابدأ بأول منتج" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="امسح الباركود، وسنضيف الصنف هنا" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>

      </Grid>
      <Border Grid.Row="2" BorderBrush="#E9EEF5" BorderThickness="0,1,0,0" Padding="12,9"><TextBlock Text="كرر المسح لزيادة الكمية · اختر وحدة البيع لتغيير السعر" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"/></Border>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}" Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="الدفع والإجراءات" FontSize="17" FontWeight="Bold"/><TextBlock Text="اختر طريقة الدفع ثم أكمل البيع" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Border Background="#F2F8F5" CornerRadius="11" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="المبلغ المطلوب" Style="{StaticResource Caption}"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" MaxHeight="34"><TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="29" FontWeight="Bold" Foreground="#128367"/></Viewbox>
       <DockPanel Margin="0,8,0,0" Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="المتبقي" Foreground="#B45309"/><TextBlock Text="{Binding CreditRemaining, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#B45309" FontWeight="SemiBold"/></DockPanel>
      </StackPanel></Border>
      <Button Click="CheckoutClicked" Background="#159879" Foreground="White" Padding="12,14" ToolTip="إتمام البيع وطباعة الوصل · F12">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Style.Triggers><DataTrigger Binding="{Binding CartLines.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="إتمام الدفع والطباعة" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="F12" Foreground="#C5F5E7" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
      </Button>
      <Button Content="إلغاء المعاملة" Click="CancelClicked" Command="{x:Null}" Style="{StaticResource ActionButton}" Foreground="#C94960" Background="#FDECF0" Margin="0,8,0,0"/>
      <Button Content="إعادة طباعة آخر وصل" Command="{Binding ReprintCommand}" Background="Transparent" Foreground="#64748B" Padding="8,7" FontSize="11"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Button Click="SearchClicked" Style="{StaticResource ActionButton}" Background="#EAF1FF" Foreground="#3368C6" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#3368C6" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="بحث عن دواء" Foreground="#3368C6" FontWeight="SemiBold"/><TextBlock Text="F9" Foreground="#6589C7" FontSize="10" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
       <Button Content="ملف العميل" Click="CustomerProfileClicked" Style="{StaticResource ActionButton}" Background="#EAF1FF" Foreground="#3368C6" Margin="0,0,0,16"/>
       <UniformGrid Columns="3" Margin="-3,0,-3,12">
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCash, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="نقدي" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCard, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="بطاقة" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
        <RadioButton GroupName="Payment" IsChecked="{Binding IsCredit, Mode=TwoWay}" Style="{StaticResource PaymentChip}"><StackPanel><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="آجل" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></RadioButton>
       </UniformGrid>
       <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,15"/>

       <TextBlock Text="العميل" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <ComboBox x:Name="CustomerBox" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomer}" IsTextSearchEnabled="True"/>
       <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,12,0,0">
        <DockPanel><TextBlock Text="الرصيد السابق" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerDebt, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#B45309"/></DockPanel>
        <Border Background="#FFFBEB" CornerRadius="9" Padding="10" Margin="0,10,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasCreditCustomer}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="اختر عميلاً مسجلاً لحفظ الدين باسمه" Foreground="#B45309" FontSize="12" TextWrapping="Wrap"/></Border>
        <TextBlock Text="المبلغ المستلم الآن" FontWeight="SemiBold" Margin="0,16,0,7"/>
        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" FontSize="23" Padding="12" FlowDirection="LeftToRight"/>
        <DockPanel Margin="0,7,0,0"><TextBlock Text="دفعة نقدية اختيارية" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="استلام كامل المبلغ" Command="{Binding PayAllCreditCommand}" Background="Transparent" Foreground="#0F766E" Padding="0,3" FontSize="11" HorizontalAlignment="Left"/></DockPanel>
        <DockPanel Margin="0,12,0,0"><TextBlock Text="رصيد العميل بعد البيع" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerBalanceAfterSale, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/></DockPanel>
       </StackPanel>
       <Expander Header="الخصم والوصفة الطبية" Margin="0,18,0,0">
        <Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding HasUnresolvedPrescriptionRequirement}" Value="True"><Setter Property="IsExpanded" Value="True"/></DataTrigger></Style.Triggers></Style></Expander.Style>
        <StackPanel Margin="0,10,0,0"><TextBlock Text="خصم إضافي على الفاتورة" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Text="الوصفة الطبية المرتبطة" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding FillablePrescriptions}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedPrescription}"/>
         <TextBlock Text="يلزم ربط وصفة لهذا الصنف قبل البيع" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasUnresolvedPrescriptionRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="4" CornerRadius="14" Padding="20,13" Background="#192C44">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="المجموع الفرعي" Foreground="#AEC0D6" FontSize="11"/><TextBlock Text="{Binding SubTotal, StringFormat=N2}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="الضريبة" Foreground="#AEC0D6" FontSize="11"/><TextBlock Text="{Binding TaxAmount, StringFormat=N2}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="الخصم" Foreground="#AEC0D6" FontSize="11"/><TextBlock Text="{Binding CartDiscount, StringFormat=N2}" Foreground="#F6B8C7" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    <Border Grid.Column="3" BorderBrush="#355069" BorderThickness="0,0,1,0" Padding="0,0,16,0"><StackPanel><TextBlock Text="الإجمالي النهائي" Foreground="#95E8CB" FontSize="12" FontWeight="SemiBold"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" MaxHeight="38"><TextBlock Text="{Binding TotalAmount, StringFormat=N2}" Foreground="White" FontSize="31" FontWeight="Bold" Margin="0,3,0,0"/></Viewbox></StackPanel></Border>
   </Grid>
  </Border>
  <StackPanel Grid.Row="5" Margin="0,12,0,0">
   <Button Content="التحقق من البيع السابق بعد إعادة الاتصال" Command="{Binding ResolveCheckoutCommand}" Visibility="{Binding CheckoutUncertain, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right"/>
   <Border Background="#E8F6F3" CornerRadius="10" Padding="12,9" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap"/></Border>
   <Border Background="#FFF1F3" CornerRadius="10" Padding="12,9" Margin="0,5,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#BE4056" TextWrapping="Wrap"/></Border>
   <TextBlock Text="جارٍ حفظ العملية…" Style="{StaticResource Caption}" Margin="4,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </StackPanel>

 </Grid>
</UserControl>
