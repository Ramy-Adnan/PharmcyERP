<UserControl x:Class="PharmacyERP.WPF.Views.Sales.POSView" x:Name="ViewRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="clr-namespace:PharmacyERP.WPF.Converters"
 FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#F3FAFA" UseLayoutRounding="True" SnapsToDevicePixels="True" SizeChanged="LayoutSizeChanged">
 <UserControl.Resources>
  <converters:ProductPhotoConverter x:Key="ProductPhoto"/>
  <converters:Base64LogoConverter x:Key="BrandLogo"/>
  <SolidColorBrush x:Key="Ink" Color="#123E43"/>
  <SolidColorBrush x:Key="Muted" Color="#7B879D"/>
  <SolidColorBrush x:Key="Accent" Color="#00898D"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#E6EBF2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#15233D" BlurRadius="18" ShadowDepth="3" Opacity="0.045"/></Setter.Value></Setter></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ButtonBase" TargetType="Button">
   <Setter Property="MinWidth" Value="44"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
  <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="InputBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#00898D"/><Setter TargetName="InputBorder" Property="Background" Value="White"/></Trigger>
     <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#EF4444"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="PaymentChip" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="48"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6,12"/><Setter Property="Foreground" Value="#6C7890"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Chip" Background="#F8FAFC" BorderBrush="#E6EBF2" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <StackPanel><ContentPresenter HorizontalAlignment="Center"/><Border x:Name="Dot" Background="#D9E0EA" Width="5" Height="5" CornerRadius="3" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#ECFDF5"/><Setter TargetName="Chip" Property="BorderBrush" Value="#00898D"/><Setter TargetName="Dot" Property="Background" Value="#00898D"/><Setter Property="Foreground" Value="#07656A"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#5EEAD4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="MoneyText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#07656A"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="#7B879D"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F0F3F8"/><Setter Property="MinHeight" Value="86"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F5FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5F4EF"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- A focused checkout workspace, separate from the main application's navigation. -->
  <Border Background="#063F45">
   <DockPanel Margin="7,15">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" Foreground="#99DFD7" FontSize="28" HorizontalAlignment="Center" Margin="0,8,0,22"/>
     <Button Background="#00898D" Padding="5,16" Click="AllProductsClicked"><StackPanel><TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="نقطة البيع" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Background="Transparent" Padding="5,18" Click="SearchClicked" Margin="0,8,0,0"><StackPanel><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#CCEAE8" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="بحث" Foreground="#CCEAE8" FontSize="11" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Background="Transparent" Padding="5,18" Click="CustomerProfileClicked"><StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#CCEAE8" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="ملف العميل" Foreground="#CCEAE8" FontSize="11" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Background="Transparent" Padding="4,15" Click="ReturnHomeClicked" ToolTip="العودة للرئيسية · Ctrl+Esc"><StackPanel><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="الرئيسية" Foreground="White" FontSize="11" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="16,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="BasketColumn" Width="480"/></Grid.ColumnDefinitions>
   <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E0EEED" BorderThickness="0,0,0,1" Padding="10,7,10,14" Margin="0,0,0,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="44" Height="44" CornerRadius="12" Background="#E0F3EF" Margin="0,0,10,0"><Grid>
       <Image x:Name="PharmacyLogo" Source="{Binding Branding.LogoBase64, ElementName=ViewRoot, Converter={StaticResource BrandLogo}}" Margin="4" Stretch="Uniform"/>
       <Path Data="M 6,16 L 26,16 M 16,6 L 16,26" Stroke="#00898D" StrokeThickness="4" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=PharmacyLogo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
      </Grid></Border>
      <StackPanel MaxWidth="240"><TextBlock Text="{Binding Branding.PharmacyName, ElementName=ViewRoot}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="للأدوية والعناية والجمال" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
     </StackPanel>
     <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,7,0,0"><TextBlock Text="{Binding CashierName, StringFormat='المحاسب: {0}'}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="12,0,0,0"><TextBlock x:Name="ClockText" FontSize="13" FlowDirection="LeftToRight" Foreground="#00898D"/><TextBlock Text="  ·  " Style="{StaticResource Caption}"/><TextBlock x:Name="DateText" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
     <Button Grid.Column="1" Click="ReturnHomeClicked" Content="الرئيسية  ×" Background="#DEF1F0" Foreground="#07656A" Padding="14,10" VerticalAlignment="Center" ToolTip="العودة للرئيسية · Ctrl+Esc"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding CheckoutUncertain}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <!-- Catalog: search, category tabs and photo cards. -->
    <Grid x:Name="CatalogPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Path Stroke="#539894" StrokeThickness="2" Data="M 0,0 L 0,24 M 4,0 L 4,24 M 10,0 L 10,24 M 13,0 L 13,24 M 18,0 L 18,24 M 22,0 L 22,24" Width="22" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <TextBox Grid.Column="1" x:Name="ScanBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="ScanTextChanged" PreviewKeyDown="ScanKeyDown" FlowDirection="LeftToRight" FontSize="20" Padding="12,9" ToolTip="امسح الباركود أو ابحث عن منتج · F9" AutomationProperties.Name="الباركود أو اسم الصنف"/>
       <TextBlock Grid.Column="1" Text="امسح الباركود أو ابحث عن منتج" Foreground="#8BB0AD" FontSize="16" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <Button Grid.Column="2" Command="{Binding SearchCommand}" Background="Transparent" Padding="12" ToolTip="بحث"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#07656A" FontSize="22"/></Button>
      </Grid>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <RadioButton GroupName="CatalogCategories" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding DataContext.BrowseCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,7,0">
         <RadioButton.Template><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Background="#E8F3F2" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1" Padding="15,12"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#438F8D" FontSize="19" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#D6F0EE"/><Setter TargetName="Tab" Property="BorderBrush" Value="#00898D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RadioButton.Template>
        </RadioButton>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <DockPanel Grid.Row="2" Margin="5,0,5,8"><TextBlock Text="{Binding ResultsTitle}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ProductCards.Count, StringFormat='{}{0} صنف'}" Style="{StaticResource Caption}" HorizontalAlignment="Left"/></DockPanel>
     <Grid Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
       <ItemsControl ItemsSource="{Binding ProductCards}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Card}" Width="{Binding ProductCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="280" Margin="5" Padding="11">
          <Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid>
            <Image x:Name="ProductPhoto" Source="{Binding PhotoPath, Converter={StaticResource ProductPhoto}}" Stretch="Uniform" Margin="10,0"/>
            <Border Background="#EDF8F6" CornerRadius="12" Margin="12,4"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=ProductPhoto}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Path Data="M 8,0 L 20,0 Q 28,0 28,8 L 28,24 Q 28,32 20,32 L 8,32 Q 0,32 0,24 L 0,8 Q 0,0 8,0 M 0,16 L 28,16" Stroke="#9DCFC8" StrokeThickness="2" Width="31" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Button Click="ChooseProductImageClicked" Content="&#xE722;" FontFamily="Segoe MDL2 Assets" Background="#E5F4F1" Foreground="#539894" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="اختيار صورة للصنف" AutomationProperties.Name="اختيار صورة للصنف"/>
           </Grid>
           <TextBlock Grid.Row="1" Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,7,0,3" ToolTip="{Binding Item.DisplayName}"/>
           <TextBlock Grid.Row="2" Text="{Binding Item.Strength}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis"/>
           <Grid Grid.Row="3" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><Border CornerRadius="5" Padding="5,3" HorizontalAlignment="Right"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E3F8EC"/><Style.Triggers><DataTrigger Binding="{Binding Item.AvailableQuantity}" Value="0"><Setter Property="Background" Value="#FDEBED"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StockStatus}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#368C69"/><Style.Triggers><DataTrigger Binding="{Binding Item.AvailableQuantity}" Value="0"><Setter Property="Foreground" Value="#BC4D5B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="{Binding StockText}" Style="{StaticResource Caption}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><TextBlock Text="{Binding Price, StringFormat=N2}" FontWeight="SemiBold" FontSize="15" Foreground="#07656A"/><TextBlock Text="{Binding UnitName}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Left"/></StackPanel>
           </Grid>
           <Button Grid.Row="4" Content="+  إضافة" Background="#E8F6F4" Foreground="#07656A" BorderBrush="#B8DEDA" Padding="6,7" Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="لا توجد أصناف للعرض؛ جرّب البحث أو تصنيفًا آخر" Foreground="#75A3A0" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProductCards.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <Button Grid.Row="4" Content="عرض المزيد من الأصناف" Command="{Binding LoadMoreProductsCommand}" Visibility="{Binding HasMoreProducts, Converter={StaticResource BoolToVisibilityConverter}}" Background="#E2F2F0" Foreground="#07656A" Margin="5,7,5,0" Padding="12,8"/>
    </Grid>
   </Grid>
  <StackPanel Grid.Row="2" Margin="0,6,0,0">
   <Button Content="التحقق من البيع السابق بعد إعادة الاتصال" Command="{Binding ResolveCheckoutCommand}" Visibility="{Binding CheckoutUncertain, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right"/>
   <Border Background="#E8F6F3" CornerRadius="10" Padding="12,9" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" TextWrapping="Wrap"/></Border>
   <Border Background="#FFF1F3" CornerRadius="10" Padding="12,9" Margin="0,5,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{Binding ErrorMessage}" Foreground="#BE4056" TextWrapping="Wrap"/></Border>
   <TextBlock Text="جارٍ تنفيذ العملية…" Style="{StaticResource Caption}" Margin="4,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </StackPanel>
   </Grid>
    <!-- Independent columns prevent header and status sizing from expanding the basket. -->
    <Grid Grid.Column="2" VerticalAlignment="Stretch" ClipToBounds="True">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding CheckoutUncertain}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10"><DockPanel Margin="0,0,0,10"><TextBlock Text="نقطة البيع" FontSize="23" FontWeight="Bold"/><Border Background="#DDF2EF" CornerRadius="7" Padding="8,5" HorizontalAlignment="Left"><TextBlock Text="{Binding ItemCount, StringFormat='{}{0} قطعة'}" Foreground="#07656A" FontWeight="SemiBold"/></Border></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CustomerBox" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomer}" IsTextSearchEnabled="True"/><Button Grid.Column="1" Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" Click="CustomerProfileClicked" Background="#E2F2F0" Foreground="#07656A" Padding="12" Margin="7,0,0,0" ToolTip="ملف العميل"/></Grid>
     </StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid><DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column" EnableRowVirtualization="True" Background="White" RowBackground="White" AlternatingRowBackground="#F5FAF9" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.PanningMode="Both">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="الصنف / الوحدة" Width="*" MinWidth="96" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="7,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding PhotoPath, Converter={StaticResource ProductPhoto}}" Width="36" Height="36" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Code}" Style="{StaticResource Caption}" FontSize="9"/></StackPanel></Grid><ComboBox DropDownClosed="SaleUnitClosed" PreviewKeyDown="SaleUnitKeyDown" ItemsSource="{Binding SaleUnits}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSaleUnit, UpdateSourceTrigger=PropertyChanged}" Padding="6" FontSize="13" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="الكمية" Width="136"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="+" Style="{StaticResource MiniButton}" Width="44" Height="44" Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="36" MinHeight="44" Padding="2,5" FontSize="16" TextAlignment="Center" Margin="3,0"/><Button Content="−" Style="{StaticResource MiniButton}" Width="44" Height="44" Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn x:Name="UnitPriceColumn" Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}" Width="74"/>
        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" ElementStyle="{StaticResource MoneyText}" Width="76" IsReadOnly="True"/>
        <DataGridTemplateColumn Width="48" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Style="{StaticResource MiniButton}" Width="44" Height="44" Foreground="#CA5762" Background="Transparent" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
       <TextBlock Text="امسح منتجًا أو أضفه من الكروت" Foreground="#75A3A0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CartLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </Border>
     <ScrollViewer x:Name="PaymentOptionsScroll" Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,10,0,0">
     <StackPanel>
      <Border Style="{StaticResource Card}" Padding="12,10"><StackPanel>
       <DockPanel><TextBlock Text="المجموع الفرعي"/><TextBlock Text="{Binding SubTotal, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/></DockPanel>
       <DockPanel Margin="0,5,0,0"><TextBlock Text="الضريبة" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TaxAmount, StringFormat=N2}" HorizontalAlignment="Left" Style="{StaticResource Caption}"/></DockPanel>
       <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="خصم الفاتورة" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="7,5" TextAlignment="Center"/></Grid>
      </StackPanel></Border>
      <Border Background="#DAF2EF" CornerRadius="11" Padding="13,10" Margin="0,7,0,7"><DockPanel><TextBlock Text="المجموع الكلي" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="25" FontWeight="Bold" Foreground="#07656A" HorizontalAlignment="Left"/></DockPanel></Border>
      <UniformGrid Columns="2" Margin="-3,0,-3,3">
       <RadioButton GroupName="Payment" IsChecked="{Binding IsCash, Mode=TwoWay}" Style="{StaticResource PaymentChip}" Padding="8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="#07656A" FontSize="19" Margin="0,0,9,0"/><TextBlock Text="نقدي" FontWeight="SemiBold"/></StackPanel></RadioButton>
       <RadioButton GroupName="Payment" IsChecked="{Binding IsCredit, Mode=TwoWay}" Style="{StaticResource PaymentChip}" Padding="8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#07656A" FontSize="19" Margin="0,0,9,0"/><TextBlock Text="آجل" FontWeight="SemiBold"/></StackPanel></RadioButton>
      </UniformGrid>
       <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,0,0">
        <DockPanel><TextBlock Text="الرصيد السابق" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerDebt, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#B45309"/></DockPanel>
        <Border Background="#FFFBEB" CornerRadius="9" Padding="10" Margin="0,6,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasCreditCustomer}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="اختر عميلاً مسجلاً لحفظ الدين باسمه" Foreground="#B45309" FontSize="12" TextWrapping="Wrap"/></Border>
        <TextBlock Text="المبلغ المستلم الآن" FontWeight="SemiBold" Margin="0,8,0,5"/>
        <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" FontSize="19" Padding="8" FlowDirection="LeftToRight"/>
        <DockPanel Margin="0,7,0,0"><TextBlock Text="دفعة نقدية اختيارية" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="استلام كامل المبلغ" Command="{Binding PayAllCreditCommand}" Background="Transparent" Foreground="#0F766E" Padding="0,3" FontSize="11" HorizontalAlignment="Left"/></DockPanel>
        <DockPanel Margin="0,6,0,0"><TextBlock Text="رصيد العميل بعد البيع" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CustomerBalanceAfterSale, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="SemiBold"/></DockPanel>
       </StackPanel>


      <Expander Header="الوحدات والخصم والوصفة" Margin="0,4,0,5"><Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding HasUnresolvedPrescriptionRequirement}" Value="True"><Setter Property="IsExpanded" Value="True"/></DataTrigger></Style.Triggers></Style></Expander.Style><StackPanel><Button Content="إضافة الصنف بوحدة أخرى" Command="{Binding AddOtherUnitCommand}" Background="#E2F2F0" Padding="8"/>
        <StackPanel Margin="0,10,0,0"><TextBlock Text="سعر الوحدة للصنف المحدد" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox Text="{Binding SelectedCartLine.UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,0,10"/><TextBlock Text="خصم الصنف المحدد في السلة" Style="{StaticResource Caption}" Margin="0,0,0,6"/><TextBox  Text="{Binding SelectedCartLine.DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Text="الوصفة الطبية المرتبطة" Style="{StaticResource Caption}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding FillablePrescriptions}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedPrescription}"/>
         <TextBlock Text="يلزم ربط وصفة لهذا الصنف قبل البيع" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasUnresolvedPrescriptionRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
      </StackPanel></Expander>
     </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="3" Margin="0,7,0,0">
      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="إلغاء / فاتورة جديدة" Click="CancelClicked" Background="#FDEBED" Foreground="#BC4D5B" FontSize="12" Padding="8,8"/><Button Grid.Column="1" Content="إعادة طباعة آخر وصل" Command="{Binding ReprintCommand}" Background="#E2F2F0" Foreground="#07656A" FontSize="11" Padding="8,8" Margin="6,0,0,0"/></Grid>
      <Button Click="CheckoutClicked" Background="#00898D" Foreground="White" Padding="12,14" ToolTip="حفظ البيع وطباعة الوصل · F12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Style.Triggers><DataTrigger Binding="{Binding CartLines.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="19" Margin="0,0,10,0"/><TextBlock Text="إتمام البيع والطباعة" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="F12" Foreground="#BEF0E9" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
     </StackPanel>
    </Grid>



  </Grid>
 </Grid>
</UserControl>
