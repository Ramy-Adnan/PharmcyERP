<UserControl x:Class="PharmacyERP.WPF.Views.Sales.POSView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" Background="#F1F5F9">
 <UserControl.Resources>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#0F766E" CornerRadius="14" Padding="18,12" Margin="0,0,0,14">
   <DockPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="نقطة البيع" FontSize="26" FontWeight="Bold" Foreground="White"/>
    <TextBlock Text="امسح الباركود لإضافة الصنف • أعد المسح لزيادة الكمية" Foreground="#CCFBF1" FontSize="13"/></StackPanel>
    <TextBlock Text="F9 مسح / بحث     F12 بيع وطباعة" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Opacity" Value="0.7"/></DataTrigger><DataTrigger Binding="{Binding CheckoutUncertain}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="باركود الصنف أو الاسم" Foreground="#475569" Margin="0,0,0,6"/>
       <TextBox x:Name="ScanBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="ScanTextChanged" PreviewKeyDown="ScanKeyDown" FlowDirection="LeftToRight" FontSize="20"/>
      </StackPanel><Button Grid.Column="1" Content="بحث" Margin="10,23,0,0" Command="{Binding SearchCommand}" Background="#E0F2F1"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Margin="0,0,0,10">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Panel}"><Style.Triggers><DataTrigger Binding="{Binding SearchResults.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button DockPanel.Dock="Bottom" Content="إضافة الصنف المحدد" Command="{Binding AddToCartCommand}"/>
      <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150" RowHeight="34">
       <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddToCartCommand}"/></DataGrid.InputBindings>
       <DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/><DataGridTextColumn Header="السعر" Binding="{Binding DefaultSalePrice, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="المتوفر" Binding="{Binding AvailableQuantity}" Width="65"/></DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}">
     <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="سلة البيع" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding ItemCount, StringFormat='  •  {0} قطعة'}" Foreground="#0F766E" VerticalAlignment="Center"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حذف المحدد" Command="{Binding RemoveLineCommand}" Foreground="#B91C1C"/><Button Content="تفريغ" Command="{Binding ClearCartCommand}"/></StackPanel>
      </DockPanel>
      <DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="44" FontSize="14" GridLinesVisibility="Horizontal" BorderThickness="0" EnableRowVirtualization="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="العدد" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="65"/>
        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="85"/>
        <DataGridTextColumn Header="خصم" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="70"/>
        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource Panel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="الدفع وإتمام البيع" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>
     <TextBlock Text="العميل"/><ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCustomer}" IsTextSearchEnabled="True"/>
     <TextBlock Text="{Binding CustomerDebt, StringFormat='الدين الحالي على العميل: {0:N2}'}" Foreground="#B45309" Margin="0,0,0,12"/>
     <TextBlock Text="طريقة الدفع"/>
     <ComboBox ItemsSource="{Binding PaymentMethods}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding PaymentMethod}"/>
     <TextBlock Text="{Binding PaymentHint}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="الوصفة الطبية (للأصناف المقيدة)" FontSize="12"/>
     <ComboBox ItemsSource="{Binding FillablePrescriptions}" DisplayMemberPath="Number" SelectedItem="{Binding SelectedPrescription}"/>
     <TextBlock Text="اربط الوصفة الطبية قبل البيع" Foreground="#B45309" Visibility="{Binding HasUnresolvedPrescriptionRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>
     <TextBlock Text="خصم إضافي"/><TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,4,0,10"/>
     <DockPanel><TextBlock Text="المجموع"/><TextBlock Text="{Binding SubTotal, StringFormat=N2}" HorizontalAlignment="Left"/></DockPanel>
     <DockPanel Margin="0,5"><TextBlock Text="الضريبة"/><TextBlock Text="{Binding TaxAmount, StringFormat=N2}" HorizontalAlignment="Left"/></DockPanel>
     <Border Background="#F0FDFA" CornerRadius="10" Padding="12" Margin="0,10">
      <StackPanel><TextBlock Text="المبلغ المطلوب" Foreground="#0F766E"/><TextBlock Text="{Binding TotalAmount, StringFormat=N2}" FontSize="34" FontWeight="Bold" Foreground="#115E59"/></StackPanel>
     </Border>
     <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVisibilityConverter}}">
      <TextBlock Text="النقد المستلم"/><DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Left" Content="المبلغ كامل" Command="{Binding ExactCashCommand}"/><TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></DockPanel>
      <TextBlock Text="{Binding ChangeDue, StringFormat='الباقي للعميل: {0:N2}'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
     </StackPanel>
     <Button Content="بيع وطباعة  •  F12" Click="CheckoutClicked" Background="#0F766E" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Padding="14,16"/>
     <Button Content="إعادة طباعة آخر وصل" Command="{Binding ReprintCommand}"/>
     <TextBlock Text="الطابعة الافتراضية في Windows • وصل 80mm" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,8"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="4,10,4,0">
   <Button Content="التحقق من البيع السابق بعد إعادة الاتصال" Command="{Binding ResolveCheckoutCommand}" Visibility="{Binding CheckoutUncertain, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right"/>
   <TextBlock Text="{Binding SuccessMessage}" Foreground="#0F766E" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap"/>
   <TextBlock Text="جارٍ حفظ العملية…" Foreground="#64748B" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </StackPanel>
 </Grid>
</UserControl>
