<Window x:Class="PharmacyERP.WPF.Views.Security.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعادة تعيين كلمة المرور" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding UserDisplayName, StringFormat='إعادة تعيين كلمة مرور: {0}'}" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Padding="6" Margin="0,0,0,12" PasswordChanged="NewPasswordBox_PasswordChanged"/>

            <TextBlock Text="تأكيد كلمة المرور" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="6" Margin="0,0,0,12" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
