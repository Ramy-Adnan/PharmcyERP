<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Security.ResetPasswordDialog" Title="إعادة تعيين كلمة المرور" Height="400" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding UserDisplayName, StringFormat='إعادة تعيين كلمة مرور: {0}'}" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="كلمة المرور الجديدة" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="NewPasswordBox" Padding="6" Margin="0,0,0,12" PasswordChanged="NewPasswordBox_PasswordChanged"/>
                    <TextBlock Text="تأكيد كلمة المرور" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="6" Margin="0,0,0,12" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="1" Margin="0,16,0,0">
                <WrapPanel HorizontalAlignment="Left" Margin="0">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
