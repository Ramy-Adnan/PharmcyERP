<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Security.RoleEditDialog" Title="{Binding DialogTitle}" Height="670" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="اسم الدور" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                <TextBlock Text="الوصف" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                <TextBlock Text="الصلاحيات" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PermissionGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Module}" FontWeight="Bold" Foreground="#1F6F50" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Permissions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="12,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="2" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                        <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
