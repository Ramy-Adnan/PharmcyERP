<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Security.UserEditDialog" Title="{Binding DialogTitle}" Height="690" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="الاسم الكامل" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم المستخدم" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="رقم الهاتف" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الدور" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RoleId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الفرع الافتراضي" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DefaultBranchId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="صلاحية وصول إضافية لفروع أخرى" Margin="0,0,0,6" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding AdditionalBranches}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding PasswordFieldLabel}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="PasswordBoxControl" Padding="6" Margin="0,0,0,12" PasswordChanged="PasswordBoxControl_PasswordChanged"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="1" Margin="0,16,0,0">
                <WrapPanel HorizontalAlignment="Left" Margin="0">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
