<Window x:Class="PharmacyERP.WPF.Views.Security.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="640" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="الاسم الكامل" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="اسم المستخدم" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="رقم الهاتف" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الدور" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding RoleId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الفرع الافتراضي" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding DefaultBranchId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="صلاحية وصول إضافية لفروع أخرى" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding AdditionalBranches}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding PasswordFieldLabel}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBoxControl" Padding="6" Margin="0,0,0,12"
                             PasswordChanged="PasswordBoxControl_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
