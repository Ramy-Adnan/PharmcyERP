<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Security.RolesView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel>
                <TextBlock Text="الأدوار والصلاحيات" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
                <Button Content="دور جديد" Margin="16,0,0,0" Command="{Binding AddRoleCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DockPanel>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0" HorizontalAlignment="Left">
                        <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditRoleCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="حذف" Command="{Binding DeleteRoleCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الدور" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="عدد الصلاحيات" Binding="{Binding PermissionCodes.Count}" Width="110"/>
                        <DataGridTextColumn Header="عدد المستخدمين" Binding="{Binding UserCount}" Width="110"/>
                        <DataGridCheckBoxColumn Header="دور نظام" Binding="{Binding IsSystemRole}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
