<UserControl x:Class="PharmacyERP.WPF.Views.Security.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الأدوار والصلاحيات" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="دور جديد" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddRoleCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditRoleCommand}"/>
                    <Button Content="حذف" Padding="12,6" Foreground="#DC2626" Command="{Binding DeleteRoleCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الدور" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="عدد الصلاحيات" Binding="{Binding PermissionCodes.Count}" Width="110"/>
                        <DataGridTextColumn Header="عدد المستخدمين" Binding="{Binding UserCount}" Width="110"/>
                        <DataGridCheckBoxColumn Header="دور نظام" Binding="{Binding IsSystemRole}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
