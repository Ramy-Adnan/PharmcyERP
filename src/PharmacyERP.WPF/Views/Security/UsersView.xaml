<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Security.UsersView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel>
                <TextBlock Text="إدارة المستخدمين" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
                <Button Content="مستخدم جديد" Margin="16,0,0,0" Command="{Binding AddUserCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DockPanel>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0" HorizontalAlignment="Left">
                        <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditUserCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="تفعيل / تعطيل" Margin="0,0,8,0" Command="{Binding ToggleStatusCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="إعادة تعيين كلمة المرور" Margin="0,0,8,0" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="إلغاء القفل" Command="{Binding UnlockCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="140"/>
                        <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="160"/>
                        <DataGridTextColumn Header="الفرع الافتراضي" Binding="{Binding DefaultBranchName}" Width="160"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
