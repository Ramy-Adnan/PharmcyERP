<UserControl x:Class="PharmacyERP.WPF.Views.Security.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="إدارة المستخدمين" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="مستخدم جديد" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddUserCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditUserCommand}"/>
                    <Button Content="تفعيل / تعطيل" Padding="12,6" Margin="0,0,8,0" Command="{Binding ToggleStatusCommand}"/>
                    <Button Content="إعادة تعيين كلمة المرور" Padding="12,6" Margin="0,0,8,0" Command="{Binding ResetPasswordCommand}"/>
                    <Button Content="إلغاء القفل" Padding="12,6" Command="{Binding UnlockCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="140"/>
                        <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="160"/>
                        <DataGridTextColumn Header="الفرع الافتراضي" Binding="{Binding DefaultBranchName}" Width="160"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
