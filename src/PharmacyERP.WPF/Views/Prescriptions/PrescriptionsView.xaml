<UserControl x:Class="PharmacyERP.WPF.Views.Prescriptions.PrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الوصفات الطبية" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="وصفة جديدة" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddPrescriptionCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="فتح التفاصيل" Padding="12,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                            Command="{Binding OpenDetailCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Prescriptions}" SelectedItem="{Binding SelectedPrescription}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="130"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="150"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ الوصفة" Binding="{Binding PrescriptionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding LineCount}" Width="90"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
