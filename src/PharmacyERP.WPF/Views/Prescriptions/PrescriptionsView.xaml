<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Prescriptions.PrescriptionsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel>
                <TextBlock Text="الوصفات الطبية" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
                <Button Content="وصفة جديدة" Margin="16,0,0,0" Command="{Binding AddPrescriptionCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DockPanel>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0" HorizontalAlignment="Left">
                        <Button Content="فتح التفاصيل" Command="{Binding OpenDetailCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Prescriptions}" SelectedItem="{Binding SelectedPrescription}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="130"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="150"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ الوصفة" Binding="{Binding PrescriptionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding LineCount}" Width="90"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
