<Window x:Class="PharmacyERP.WPF.Views.Prescriptions.PrescriptionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الوصفة الطبية" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="رقم الوصفة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="العميل" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.CustomerName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الطبيب" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.DoctorName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Status}" FontWeight="Bold" Foreground="#1F6F50"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      RowHeight="32" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*"/>
                    <DataGridTextColumn Header="الكمية الموصوفة" Binding="{Binding QuantityPrescribed}" Width="110"/>
                    <DataGridTextColumn Header="تم صرفه" Binding="{Binding QuantityDispensed}" Width="90"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding QuantityRemaining}" Width="90"/>
                    <DataGridTextColumn Header="تعليمات الجرعة" Binding="{Binding DosageInstructions}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء الوصفة" Padding="16,8" Foreground="#DC2626" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Content="إغلاق" Padding="16,8" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
