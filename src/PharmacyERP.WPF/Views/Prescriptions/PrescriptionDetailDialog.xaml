<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Prescriptions.PrescriptionDetailDialog" Title="تفاصيل الوصفة الطبية" Height="610" Width="760" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="رقم الوصفة" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="العميل" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.CustomerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="الطبيب" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.DoctorName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="الحالة" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Header.Status}" FontWeight="Bold" Foreground="#1F6F50" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="2*"/>
                        <DataGridTextColumn Header="الكمية الموصوفة" Binding="{Binding QuantityPrescribed}" Width="110"/>
                        <DataGridTextColumn Header="تم صرفه" Binding="{Binding QuantityDispensed}" Width="90"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding QuantityRemaining}" Width="90"/>
                        <DataGridTextColumn Header="تعليمات الجرعة" Binding="{Binding DosageInstructions}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="3" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="إلغاء الوصفة" Command="{Binding CancelCommand}" Margin="0,0,8,0" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                        <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
