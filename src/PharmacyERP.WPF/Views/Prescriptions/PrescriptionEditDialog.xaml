<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Prescriptions.PrescriptionEditDialog" Title="{Binding DialogTitle}" Height="710" Width="820" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource WorkspaceCardStyle}" Margin="20" Padding="16">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="العميل" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CustomerId}" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الطبيب" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Doctors}" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectedValue="{Binding DoctorId}" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="الفرع" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BranchId}" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="تاريخ الانتهاء (اختياري)" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <DatePicker SelectedDate="{Binding ExpiryDate}" Padding="6"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="10" HorizontalAlignment="Left">
                        <Button Content="إضافة صنف" Margin="0,0,8,0" Command="{Binding AddLineCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                        <Button Content="حذف الصنف" Command="{Binding RemoveLineCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource WorkspaceDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="الصنف (يتطلب وصفة)" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" Margin="6,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="ItemCombo" ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ItemId}" SelectionChanged="ItemCombo_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="وحدة المخزون الصغيرة" Binding="{Binding UnitName}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكمية الموصوفة" Binding="{Binding QuantityPrescribed, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="تعليمات الجرعة" Binding="{Binding DosageInstructions, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,8,8" Grid.Row="3" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="ملاحظات" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Background="#FEF2F2" Padding="8,6"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"/>
                        <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
