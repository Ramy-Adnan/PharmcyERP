<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.SystemManagement.UpdateCheckDialog" Title="التحقق من التحديثات" Height="560" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="460" MinHeight="400">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}">
            <TextBlock Text="التحقق من التحديثات" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Padding="20" Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="الإصدار الحالي" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Result.CurrentVersion}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="جارٍ التحقق من وجود تحديثات..." Foreground="#6B7280"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding Result.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="يتوفر تحديث جديد!" FontWeight="Bold" Foreground="#1F6F50" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Result.LatestVersion, StringFormat='الإصدار الجديد: {0}'}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Result.ReleaseNotes}" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,12"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12" Foreground="#1F6F50"/>
                        </StackPanel>
                        <TextBlock Text="التطبيق محدَّث لأحدث إصدار." FontWeight="SemiBold" Foreground="#1F6F50" Visibility="{Binding Result.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Background="#F9FAFB" BorderThickness="0,1,0,0" Padding="12" Margin="0,12,0,0" Grid.Row="3">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="تنزيل وتثبيت الآن" Command="{Binding DownloadAndInstallCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
