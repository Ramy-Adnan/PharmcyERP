<Window x:Class="PharmacyERP.WPF.Views.SystemManagement.UpdateCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التحقق من التحديثات" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="الإصدار الحالي" FontSize="12" Foreground="#9CA3AF"/>
            <TextBlock Text="{Binding Result.CurrentVersion}" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="جارٍ التحقق من وجود تحديثات..." Foreground="#6B7280"/>
            </StackPanel>

            <StackPanel Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Visibility="{Binding Result.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="يتوفر تحديث جديد!" FontWeight="Bold" Foreground="#1F6F50" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Result.LatestVersion, StringFormat='الإصدار الجديد: {0}'}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Result.ReleaseNotes}" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,12"/>

                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12"/>
                </StackPanel>

                <TextBlock Text="التطبيق محدَّث لأحدث إصدار." FontWeight="SemiBold" Foreground="#1F6F50"
                           Visibility="{Binding Result.IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="تنزيل وتثبيت الآن" Padding="16,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding DownloadAndInstallCommand}" Margin="0,0,8,0"/>
            <Button Content="إغلاق" Padding="16,8" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
