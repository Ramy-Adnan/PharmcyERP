<Window x:Class="PharmacyERP.WPF.Views.SystemManagement.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد الصيدلية للمرة الأولى" Width="760" Height="760" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        FontFamily="{DynamicResource WorkspaceFont}" Background="#F9FAFB"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Closing="WindowClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}">
            <StackPanel>
                <TextBlock Text="مرحباً بك في Pharmacy ERP" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <TextBlock Text="جهّز اتصال الصيدلية بأمان. قاعدة الصيدلية الحالية تبقى محفوظة، ولا تُمسح أثناء الإعداد." Style="{StaticResource WorkspaceMutedTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource WorkspaceCardStyle}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel IsEnabled="{Binding CanInteract}">
                    <Border Background="#FFFBEB" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EnvironmentOverride}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="اتصال Windows الخارجي له الأولوية، لذلك حقوله مقفلة هنا. يمكنك اختباره أو إنشاء القاعدة بالاسم نفسه. لتغيير الخادم أو القاعدة، عدّل أو احذف متغير الاتصال ثم أعد تشغيل التطبيق." TextWrapping="Wrap" Foreground="#92400E"/>
                    </Border>
                    <TextBlock Text="طريقة الإعداد" Style="{StaticResource WorkspaceSectionHeaderStyle}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <RadioButton Content="الاتصال بقاعدة موجودة" IsChecked="{Binding UseExisting, Mode=TwoWay}" Margin="0,4,24,4"/>
                        <RadioButton Content="إنشاء قاعدة لصيدلية جديدة" IsChecked="{Binding CreateNew, Mode=TwoWay}" Margin="0,4"/>
                    </WrapPanel>
                    <Grid IsEnabled="{Binding CanEditConnection}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="اسم خادم SQL Server" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="مثال: .\SQLEXPRESS أو اسم جهاز الخادم" Style="{StaticResource WorkspaceMutedTextStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم قاعدة البيانات" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="استخدام مصادقة حساب Windows الحالي" IsChecked="{Binding WindowsAuthentication}" IsEnabled="{Binding CanEditConnection}" Margin="0,16,0,12"/>
                    <Grid IsEnabled="{Binding CanEditSqlCredentials}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="اسم مستخدم SQL Server" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="كلمة مرور SQL Server" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="SqlPasswordBox" FlowDirection="LeftToRight" PasswordChanged="SqlPasswordChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="الثقة بشهادة خادم SQL المحلي أو الداخلي" IsChecked="{Binding TrustServerCertificate}" IsEnabled="{Binding CanEditConnection}" Margin="0,14,0,12"/>
                    <Button Content="اختبار الاتصال والتعرف على القاعدة" Click="TestConnectionClicked" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Text="الاختبار لا ينشئ قاعدة ولا يعدّل بيانات. تأكد من تثبيت SQL Server وتشغيل خدمته أولاً." Style="{StaticResource WorkspaceMutedTextStyle}" Margin="0,8,0,12"/>
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAdministrator}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="حساب مدير النظام الأول: admin" FontWeight="Bold" Foreground="#166534"/>
                            <TextBlock Text="اختر كلمة مرور من 8 أحرف على الأقل. تُستخدم للتهيئة فقط ولا تُحفظ في ملف الإعدادات." TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="كلمة مرور المدير" Margin="0,0,0,6"/><PasswordBox x:Name="AdminPasswordBox" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="تأكيد كلمة المرور" Margin="0,0,0,6"/><PasswordBox x:Name="AdminConfirmationBox" FlowDirection="LeftToRight"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#166534" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource WorkspaceCardStyle}" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="تُحفظ إعدادات الاتصال مشفرة لحساب Windows الحالي." Style="{StaticResource WorkspaceMutedTextStyle}" VerticalAlignment="Center" MaxWidth="320"/>
                <WrapPanel HorizontalAlignment="Left">
                    <Button Content="حفظ وبدء النظام" Click="ContinueClicked" IsEnabled="{Binding CanContinue}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="إلغاء" Click="CancelClicked" IsEnabled="{Binding CanInteract}" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
