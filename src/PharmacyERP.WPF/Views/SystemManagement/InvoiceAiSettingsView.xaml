<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.SystemManagement.InvoiceAiSettingsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}">
            <StackPanel>
                <TextBlock Text="قراءة فواتير المذاخر من الصور" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <TextBlock Text="اختر OCR المحلي المجاني دون مفتاح أو إنترنت، أو اختر خدمة سحابية بمفتاحك." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0" Style="{StaticResource WorkspaceMutedTextStyle}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Padding="20" Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="الخدمة" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Provider}" Padding="10,8" Margin="0,6,0,14"/>
                        <StackPanel Visibility="{Binding UsesApi, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="النموذج" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Padding="10,8" MaxLength="100" Margin="0,6,0,14"/>
                            <TextBlock Text="مفتاح API" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyChanged" FlowDirection="LeftToRight" Padding="10,8" MaxLength="512" Margin="0,6,0,8"/>
                            <TextBlock Text="{Binding KeyStatus}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,18"/>
                        </StackPanel>
                        <TextBlock Text="Tesseract OCR مجاني بالكامل. ملفات العربية والإنجليزية مرفقة مع البرنامج، ولا تُرسل الصورة إلى أي موقع. دقته تعتمد على وضوح الصورة وعناوين الجدول؛ راجع النتائج قبل إدخال المخزون." Visibility="{Binding IsLocalOcr, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" Foreground="#1F6F50" Margin="0,6,0,18"/>
                    </StackPanel>
                    <Separator/>
                    <TextBlock Visibility="{Binding UsesApi, Converter={StaticResource BoolToVisibilityConverter}}" Text="Gemini له خطة مجانية بحدود حسب الحساب والنموذج. الاختبار يتحقق من المفتاح والنموذج دون إرسال فاتورة. تُرسل الصور إلى الخدمة المختارة عند التحليل، وقد تستخدم Google بيانات الخطة المجانية لتحسين منتجاتها وفق شروط حسابك." TextWrapping="Wrap" Foreground="#64748B" Margin="0,14,0,10"/>
                    <TextBlock Visibility="{Binding UsesApi, Converter={StaticResource BoolToVisibilityConverter}}" Text="يحفظ التطبيق المفتاح مشفّراً على هذا الجهاز لحساب Windows الحالي، ويظل محفوظاً بعد تحديث البرنامج. عند نقل البرنامج إلى جهاز أو حساب Windows آخر، أدخل المفتاح من الإعدادات مجدداً." TextWrapping="Wrap" Foreground="#64748B"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Padding="12" Grid.Row="4">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#1F6F50" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="{Binding TestButtonText}" Command="{Binding TestCommand}" Margin="0,0,0,8" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="حفظ إعدادات قراءة الصور" Command="{Binding SaveCommand}" Margin="10,0,0,8" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Visibility="{Binding UsesApi, Converter={StaticResource BoolToVisibilityConverter}}" Content="حذف المفتاح" Command="{Binding RemoveKeyCommand}" Margin="10,0,0,8" Style="{StaticResource DangerButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
