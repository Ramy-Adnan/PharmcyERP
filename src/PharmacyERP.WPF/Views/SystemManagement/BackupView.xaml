<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.SystemManagement.BackupView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="النسخ الاحتياطي والاستعادة" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,16,4"/>
                <Button Content="نسخة احتياطية جديدة" Margin="0,4,8,4" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateBackupCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="تحديث" Margin="0,4,0,4" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding BackupFolder, StringFormat='مجلد النسخ الاحتياطية: {0}'}" Style="{StaticResource WorkspaceMutedTextStyle}" Margin="4,0"/>
        <Border Grid.Row="4" Style="{StaticResource WorkspaceCardStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource WorkspaceCardStyle}" Background="#F8FAFC" Padding="12" Margin="10">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="استعادة النسخة المحددة" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding RestoreBackupCommand}"/>
                        <Button Content="حذف" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteBackupCommand}"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Style="{StaticResource WorkspaceDataGridStyle}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="الحجم (بايت)" Binding="{Binding SizeBytes, StringFormat={}{0:N0}}" Width="130"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
