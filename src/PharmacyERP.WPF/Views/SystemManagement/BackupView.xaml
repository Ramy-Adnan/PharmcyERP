<UserControl x:Class="PharmacyERP.WPF.Views.SystemManagement.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="النسخ الاحتياطي والاستعادة" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="نسخة احتياطية جديدة" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding CreateBackupCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding BackupFolder, StringFormat='مجلد النسخ الاحتياطية: {0}'}" FontSize="12" Foreground="#6B7280"/>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="استعادة النسخة المحددة" Padding="12,6" Margin="0,0,8,0" Background="#B45309" Foreground="White" BorderThickness="0"
                            Command="{Binding RestoreBackupCommand}"/>
                    <Button Content="حذف" Padding="12,6" Foreground="#DC2626" Command="{Binding DeleteBackupCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="الحجم (بايت)" Binding="{Binding SizeBytes, StringFormat={}{0:N0}}" Width="130"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
