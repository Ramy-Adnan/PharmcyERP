<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.SystemManagement.LicenseView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="الترخيص" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,16,4"/>
                <Button Content="تحديث" Margin="0,4" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource WorkspaceCardStyle}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="حالة الترخيص الحالية" Style="{StaticResource WorkspaceSectionHeaderStyle}" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" Foreground="{Binding Status.IsValid, Converter={StaticResource BoolToBrushConverter}}"/>
                        <Grid Visibility="{Binding Status.License, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="العميل المرخَّص له" Foreground="#6B7280" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.License.CustomerName}" Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="رمز الترخيص" Foreground="#6B7280" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.License.LicenseKey}" Margin="0,4" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="الحد الأقصى للفروع" Foreground="#6B7280" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.License.MaxBranches}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="الحد الأقصى للمستخدمين" Foreground="#6B7280" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.License.MaxUsers}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="تاريخ الانتهاء" Foreground="#6B7280" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status.License.ExpiryDate, StringFormat=yyyy-MM-dd, TargetNullValue='دائم (بلا انتهاء)'}" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkspaceCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="تفعيل ترخيص جديد" Style="{StaticResource WorkspaceSectionHeaderStyle}" Margin="0,0,0,14"/>
                        <TextBlock Text="بصمة هذا الجهاز (أرسلها للجهة المرخِّصة لإصدار ترخيص جديد):" Style="{StaticResource WorkspaceMutedTextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding HardwareFingerprint, Mode=OneWay}" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="نسخ" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyFingerprintCommand}"/>
                        </Grid>
                        <Button Content="استيراد ملف الترخيص (.lic)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ImportLicenseCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
