<UserControl x:Class="PharmacyERP.WPF.Views.SystemManagement.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20" MaxWidth="640" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الترخيص" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="تحديث" Margin="16,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="حالة الترخيص الحالية" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding Status.Message}" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"
                           Foreground="{Binding Status.IsValid, Converter={StaticResource BoolToBrushConverter}}"/>

                <Grid Visibility="{Binding Status.License, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="العميل المرخَّص له" Foreground="#6B7280" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.License.CustomerName}" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="رمز الترخيص" Foreground="#6B7280" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.License.LicenseKey}" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="الحد الأقصى للفروع" Foreground="#6B7280" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.License.MaxBranches}" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="الحد الأقصى للمستخدمين" Foreground="#6B7280" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status.License.MaxUsers}" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="تاريخ الانتهاء" Foreground="#6B7280" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status.License.ExpiryDate, StringFormat=yyyy-MM-dd, TargetNullValue='دائم (بلا انتهاء)'}" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="تفعيل ترخيص جديد" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="بصمة هذا الجهاز (أرسلها للجهة المرخِّصة لإصدار ترخيص جديد):" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding HardwareFingerprint, Mode=OneWay}" IsReadOnly="True" Padding="6"/>
                    <Button Grid.Column="2" Content="نسخ" Padding="14,6" Command="{Binding CopyFingerprintCommand}"/>
                </Grid>

                <Button Content="استيراد ملف الترخيص (.lic)" Padding="16,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                        Command="{Binding ImportLicenseCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
