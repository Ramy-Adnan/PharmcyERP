<Window x:Class="PharmacyERP.WPF.Views.Inventory.ReceiveBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استلام دفعة جديدة" Height="640" Width="560" MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ItemName}" FontSize="18" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="المخزن" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding WarehouseId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="رقم الدفعة (Batch Number)" Margin="0,0,0,4"/>
                <TextBox x:Name="BatchNumberBox" Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="تاريخ الصنع (اختياري)" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ManufactureDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="تاريخ الانتهاء الفعلي (مطلوب)" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الكمية المستلمة" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,0,0,12"/>
                <TextBlock Text="وحدة الاستلام"/>
                <ComboBox ItemsSource="{Binding PurchaseUnits}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedPurchaseUnit, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,4,0,8"/>
                <TextBlock Text="بونص مجاني (بنفس وحدة الاستلام)"/>
                <TextBox Text="{Binding BonusQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,4,0,8"/>
                <TextBlock Text="{Binding PackagingDescription}" TextWrapping="Wrap" Foreground="#0F766E" Margin="0,0,0,8"/>

                <TextBlock Text="نوع الشراء / نسبة زيادة البيع" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding PurchaseTypes}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding PurchaseType}" Padding="6" Margin="0,0,0,8"/>
                <TextBlock Text="تغيير النوع أو سعر الشراء يعيد الحساب؛ يمكنك تعديل البيع بعد ذلك." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>

                <TextBlock Text="سعر الشراء (للوحدة)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding SalePriceLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SalePriceOverride, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,0,0,12"/>
                <TextBlock Text="يمكن تعديل البيع يدوياً؛ تغيير الشراء يعيد الحساب حسب النوع المحدد." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
                <Button Content="{Binding RecalculatePriceLabel}" Command="{Binding CalculateSalePriceCommand}" Padding="8,4" Margin="0,0,0,12"/>

                <TextBlock Text="مرجع المورد / رقم الفاتورة (اختياري)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SupplierReference, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Background="#E8F6F3" Padding="10" CornerRadius="6" Margin="0,0,0,10"><TextBlock Text="{Binding ReceiptSummary}" Foreground="#0F766E" TextWrapping="Wrap"/></Border>
            <WrapPanel HorizontalAlignment="Left">
                <Button Content="حفظ ودفعة أخرى" ToolTip="Ctrl+Shift+S" Padding="12,8" Margin="0,0,8,0" Click="SaveAndNext_Click"/>
                <Button Content="حفظ وإغلاق" ToolTip="Ctrl+S" Padding="12,8" Background="#1F6F50" Foreground="White" BorderThickness="0" Click="SaveButton_Click" Margin="0,0,8,0"/>
                <Button Content="إغلاق" Padding="12,8" Click="CancelButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
