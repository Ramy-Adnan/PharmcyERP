<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Inventory.ItemLookupsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="تصنيفات ووحدات وشركات الأصناف" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="تحديث" Margin="16,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <TabControl Grid.Row="2" Background="White">
            <TabItem Header="التصنيفات">
                <DockPanel Margin="12">
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="إضافة صف" Margin="0,0,8,0" Command="{Binding AddCategoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="حفظ التغييرات" Margin="0,0,8,0" Command="{Binding SaveCategoriesCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="حذف المحدد" Command="{Binding DeleteCategoryCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="اسم التصنيف" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="وحدات القياس">
                <DockPanel Margin="12">
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="إضافة صف" Margin="0,0,8,0" Command="{Binding AddUnitCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="حفظ التغييرات" Margin="0,0,8,0" Command="{Binding SaveUnitsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="حذف المحدد" Command="{Binding DeleteUnitCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="اسم الوحدة" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="الشركات المصنّعة">
                <DockPanel Margin="12">
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="إضافة صف" Margin="0,0,8,0" Command="{Binding AddManufacturerCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="حفظ التغييرات" Margin="0,0,8,0" Command="{Binding SaveManufacturersCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="حذف المحدد" Command="{Binding DeleteManufacturerCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الشركة" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="البلد" Binding="{Binding Extra, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding ItemCount}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
