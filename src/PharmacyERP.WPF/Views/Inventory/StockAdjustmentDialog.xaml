<Window x:Class="PharmacyERP.WPF.Views.Inventory.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل رصيد المخزون" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding BatchDisplayName}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CurrentQuantity, StringFormat='الرصيد الحالي: {0}'}" Foreground="#6B7280" Margin="0,0,0,16"/>

            <TextBlock Text="مقدار التعديل (موجب للزيادة، سالب للنقصان)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding QuantityDelta, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>

            <TextBlock Text="{Binding ResultingQuantity, StringFormat='الرصيد بعد التعديل: {0}'}" Foreground="#1F6F50" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="سبب التعديل (إلزامي للتدقيق)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
