<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Inventory.StockAdjustmentDialog" Title="تعديل رصيد المخزون" Height="460" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13" MinHeight="400" MinWidth="400" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" Padding="16" Style="{StaticResource WorkspaceCardStyle}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="2">
                <StackPanel>
                    <TextBlock Text="{Binding BatchDisplayName}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CurrentQuantity, StringFormat='الرصيد الحالي: {0}'}" Foreground="#6B7280" Margin="0,0,0,16"/>
                    <TextBlock Text="مقدار التعديل (موجب للزيادة، سالب للنقصان)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding QuantityDelta, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ResultingQuantity, StringFormat='الرصيد بعد التعديل: {0}'}" Foreground="#1F6F50" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="سبب التعديل (إلزامي للتدقيق)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" Grid.Row="3">
                <WrapPanel HorizontalAlignment="Left" Margin="0">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
