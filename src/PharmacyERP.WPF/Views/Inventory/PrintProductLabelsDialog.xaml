<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Inventory.PrintProductLabelsDialog" Title="طباعة ملصقات الباركود" Width="880" Height="650" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Margin="0,0,0,12">
            <StackPanel Margin="0">
                <TextBlock Text="ملصق المنتج" Foreground="#172744" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" Foreground="#62738F"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="المخزن" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWarehouse}" MinHeight="38" Margin="0,0,0,12"/>
                    <TextBlock Text="الدفعة التي سيطبع سعرها" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" MinHeight="38" MaxDropDownHeight="220" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding BatchNumber}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="وحدة البيع على الملصق" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedUnit}" MinHeight="38" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Barcode, StringFormat='الباركود: {0}'}" TextWrapping="Wrap" Foreground="#62738F"/>
                    <TextBlock Text="{Binding SalePrice, StringFormat='السعر: {0:N2} د.ع'}" FontWeight="Bold" Foreground="#2463EB" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding PriceNotice}" TextWrapping="Wrap" Foreground="#8A5A13" FontSize="12" Margin="0,0,0,12"/>
                    <TextBlock Text="عدد الملصقات (1–500)"/>
                    <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" Margin="0,4,0,12"/>
                    <TextBlock Text="مقاس الملصق بالملليمتر"/>
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="العرض"/>
                            <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الارتفاع"/>
                            <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="اختر الطابعة عند الضغط على طباعة، واضبط مقاس ورقها ليتطابق مع الملصق. تغيير المقاس لا يغير سعر الصنف أو بياناته." TextWrapping="Wrap" FontSize="12" Foreground="#62738F"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="8" Padding="18" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="معاينة الملصق" FontWeight="Bold" Foreground="#172744"/>
                    <!-- Display pixels from the detached print page, never a FixedPage inside an RTL visual tree. -->
                    <Border x:Name="PreviewHost" Grid.Row="1" FlowDirection="LeftToRight" Margin="0,20"/>
                    <TextBlock x:Name="PreviewError" Grid.Row="2" TextWrapping="Wrap" Foreground="#B91C1C" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="#B45309"/>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B91C1C"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#166534"/>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="تحديث السعر" Click="RefreshClicked" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="PrintButton" Content="اختيار الطابعة والطباعة" Click="PrintClicked" IsEnabled="{Binding CanPrint}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="إغلاق" Click="CloseClicked" Style="{StaticResource SecondaryButtonStyle}"/>
        </WrapPanel>
    </Grid>
</Window>
