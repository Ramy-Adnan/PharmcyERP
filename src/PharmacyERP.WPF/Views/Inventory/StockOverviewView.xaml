<UserControl x:Class="PharmacyERP.WPF.Views.Inventory.StockOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="نظرة عامة على المخزون" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>

            <ComboBox Grid.Column="2" ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedWarehouse}" Padding="8,6" Width="200" VerticalAlignment="Center"/>

            <CheckBox Grid.Column="4" Content="عرض الأصناف تحت حد الطلب فقط" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center"/>

            <Button Grid.Column="6" Content="تحديث" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="مستويات المخزون" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>
                    <DataGrid ItemsSource="{Binding StockSummary}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding ItemCode}" Width="80"/>
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitOfMeasureName}" Width="80"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding TotalQuantityOnHand}" Width="70"/>
                            <DataGridTextColumn Header="حد الطلب" Binding="{Binding ReorderPoint}" Width="70"/>
                            <DataGridCheckBoxColumn Header="دون الحد" Binding="{Binding IsBelowReorderPoint}" Width="70"/>
                            <DataGridTextColumn Header="أقرب انتهاء" Binding="{Binding NearestExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
                        <TextBlock Text="دفعات قاربت على الانتهاء" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" (خلال " VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding ExpiryWindowDays, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="2" VerticalAlignment="Center"/>
                        <TextBlock Text=" يوم)" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ExpiringBatches}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumber}" Width="100"/>
                            <DataGridTextColumn Header="الانتهاء" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="أيام" Binding="{Binding DaysUntilExpiry}" Width="60"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityOnHand}" Width="60"/>
                            <DataGridCheckBoxColumn Header="منتهي" Binding="{Binding IsExpired}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
