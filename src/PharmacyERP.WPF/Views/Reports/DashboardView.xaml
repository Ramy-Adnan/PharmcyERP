<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Reports.DashboardView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource WorkspaceCardStyle}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#6B7280"/>
            </Style>
            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="لوحة التحكم" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}" Margin="0,4,8,4"/>
                <TextBlock Text="{Binding Summary.AsOfDate, StringFormat='- {0:yyyy-MM-dd}'}" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Content="تحديث" Margin="16,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="False">
            <StackPanel>
                <StackPanel>
                    <UniformGrid Columns="4" Rows="1">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="المبالغ المستلمة من مبيعات اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodaySalesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#1F6F50"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="عدد الفواتير اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayInvoiceCount}" Style="{StaticResource KpiValue}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="الربح الإجمالي اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayGrossProfit, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#1F6F50"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="مصاريف اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayExpensesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#B45309"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="4" Rows="1">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="أصناف أقل من الحد الأدنى" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.LowStockItemCount}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="دفعات قاربت على الانتهاء" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.ExpiringSoonCount}" Style="{StaticResource KpiValue}" Foreground="#B45309"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="دفعات منتهية الصلاحية" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.ExpiredCount}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="صافي حركة حساب النقدية اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayNetCashPosition, StringFormat=N2}" Style="{StaticResource KpiValue}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="4" Rows="1">
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="الجزء الآجل من مبيعات اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayCreditSalesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#B45309"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="مبيعات نقدية اليوم" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayCashSalesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="تحصيل ديون اليوم — ليست مبيعات جديدة" Style="{StaticResource KpiLabel}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Summary.TodayDebtCollections, StringFormat=N2}" Style="{StaticResource KpiValue}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Summary.TodayCreditDeposits, StringFormat='دفعات أولى ضمن المدفوع: {0:N2}'}" Foreground="#64748B" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" Margin="0,6,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="الأصناف الأكثر مبيعاً اليوم" FontWeight="SemiBold" FontSize="14" Margin="12,10" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        <DataGrid ItemsSource="{Binding TopSellingItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" Height="300" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                                <DataGridTextColumn Header="المباع بوحدة المخزون" Binding="{Binding QuantitySold}" Width="120"/>
                                <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
