<UserControl x:Class="PharmacyERP.WPF.Views.Reports.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="لوحة التحكم" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Summary.AsOfDate, StringFormat='- {0:yyyy-MM-dd}'}" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button Content="تحديث" Margin="16,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Rows="2">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="مبيعات اليوم" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.TodaySalesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#1F6F50"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="عدد الفواتير اليوم" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.TodayInvoiceCount}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="الربح الإجمالي اليوم" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.TodayGrossProfit, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#1F6F50"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="مصاريف اليوم" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.TodayExpensesTotal, StringFormat=N2}" Style="{StaticResource KpiValue}" Foreground="#B45309"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="أصناف أقل من الحد الأدنى" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.LowStockItemCount}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="دفعات قاربت على الانتهاء" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.ExpiringSoonCount}" Style="{StaticResource KpiValue}" Foreground="#B45309"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="دفعات منتهية الصلاحية" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.ExpiredCount}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="صافي المركز النقدي اليوم" Style="{StaticResource KpiLabel}"/>
                    <TextBlock Text="{Binding Summary.TodayNetCashPosition, StringFormat=N2}" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="الأصناف الأكثر مبيعاً اليوم" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>
                <DataGrid ItemsSource="{Binding TopSellingItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding QuantitySold}" Width="120"/>
                        <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
