<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Reports.InventoryMovementReportView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <TextBlock Text="تقرير حركة المخزون" Style="{StaticResource WorkspacePageTitleStyle}"/>
        </Border>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="2">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="الفرع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBranch}" Width="150" Margin="0,0,16,0"/>
                <TextBlock Text="الصنف:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Items}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedItem}" Width="180" Margin="0,0,16,0"/>
                <Button Content="عرض التقرير" Command="{Binding RunReportCommand}" Margin="0,4,8,4" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تصدير CSV" Command="{Binding ExportCsvCommand}" Margin="0,4,8,4" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="طباعة" Command="{Binding PrintCommand}" Margin="0,4,0,4" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TransactionAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                    <DataGridTextColumn Header="رمز الصنف" Binding="{Binding ItemCode}" Width="90"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="110"/>
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="التغير" Binding="{Binding QuantityChange}" Width="80"/>
                    <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding ResultingQuantityOnHand}" Width="120"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
