<UserControl x:Class="PharmacyERP.WPF.Views.Reports.InventoryMovementReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تقرير حركة المخزون" FontSize="20" FontWeight="Bold" Foreground="#1F2937"/>

        <WrapPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,16,0"/>
            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,16,0"/>

            <TextBlock Text="الفرع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBranch}"
                      Width="150" Margin="0,0,16,0"/>

            <TextBlock Text="الصنف:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Items}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedItem}"
                      Width="180" Margin="0,0,16,0"/>

            <Button Content="عرض التقرير" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding RunReportCommand}" Margin="0,4,8,4"/>
            <Button Content="تصدير CSV" Padding="14,6" Command="{Binding ExportCsvCommand}" Margin="0,4,8,4"/>
            <Button Content="طباعة" Padding="14,6" Command="{Binding PrintCommand}" Margin="0,4,0,4"/>
        </WrapPanel>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      RowHeight="32" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding TransactionAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                    <DataGridTextColumn Header="رمز الصنف" Binding="{Binding ItemCode}" Width="90"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="110"/>
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="التغير" Binding="{Binding QuantityChange}" Width="80"/>
                    <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding ResultingQuantityOnHand}" Width="120"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
