<UserControl x:Class="PharmacyERP.WPF.Views.Reports.SalesSummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ملخص المبيعات" FontSize="20" FontWeight="Bold" Foreground="#1F2937"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,16,0"/>
            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,16,0"/>

            <TextBlock Text="الفرع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBranch}"
                      Width="160" Margin="0,0,16,0"/>

            <Button Content="عرض التقرير" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding RunReportCommand}" Margin="0,0,8,0"/>
            <Button Content="تصدير CSV" Padding="14,6" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
            <Button Content="طباعة" Padding="14,6" Command="{Binding PrintCommand}"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24">
                <StackPanel VerticalAlignment="Top" FlowDirection="LeftToRight">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="عدد الفواتير" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Result.TotalInvoices}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="المبيعات قبل الضريبة" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Result.GrossSales, StringFormat=N2}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="إجمالي الضريبة" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Result.TotalTax, StringFormat=N2}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="إجمالي الخصم" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Result.TotalDiscount, StringFormat=N2}" HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="المبيعات المدفوعة (نقدي + بطاقة)" HorizontalAlignment="Right"/><TextBlock Text="{Binding Result.PaidSales, StringFormat=N2}" HorizontalAlignment="Left"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="مبيعات آجلة — ذمم العملاء" HorizontalAlignment="Right"/><TextBlock Text="{Binding Result.CreditSales, StringFormat=N2}" HorizontalAlignment="Left" Foreground="#B45309"/></Grid>
                    <Separator Margin="0,4"/>
                    <Grid>
                        <TextBlock Text="إجمالي الفواتير (يشمل الآجل)" HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Result.NetSales, StringFormat=N2}" HorizontalAlignment="Left" FontSize="16" FontWeight="Bold" Foreground="#1F6F50"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="حسب طريقة الدفع" FontWeight="SemiBold" FontSize="14" Margin="12,10"/>
                    <DataGrid ItemsSource="{Binding ByPaymentMethod}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="32" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodName}" Width="*"/>
                            <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="100"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
