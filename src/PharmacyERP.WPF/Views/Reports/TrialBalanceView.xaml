<UserControl x:Class="PharmacyERP.WPF.Views.Reports.TrialBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ميزان المراجعة" FontSize="20" FontWeight="Bold" Foreground="#1F2937"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="كما في تاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding AsOfDate}" Width="140" Margin="0,0,16,0"/>

            <TextBlock Text="الفرع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBranch}"
                      Width="160" Margin="0,0,16,0"/>

            <Button Content="عرض التقرير" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding RunReportCommand}" Margin="0,0,8,0"/>
            <Button Content="تصدير CSV" Padding="14,6" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
            <Button Content="طباعة" Padding="14,6" Command="{Binding PrintCommand}"/>
        </StackPanel>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#F4F6F8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الإجمالي — مدين: " FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Result.TotalDebit, StringFormat=N2}" FontWeight="Bold"/>
                        <TextBlock Text="   دائن: " FontWeight="SemiBold" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding Result.TotalCredit, StringFormat=N2}" FontWeight="Bold"/>
                        <TextBlock Text="   (غير متوازن!)" Foreground="#DC2626" FontWeight="Bold" Margin="16,0,0,0"
                                   Visibility="{Binding Result.IsBalanced, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="100"/>
                        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding AccountType}" Width="110"/>
                        <DataGridTextColumn Header="مدين" Binding="{Binding TotalDebit, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="دائن" Binding="{Binding TotalCredit, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
