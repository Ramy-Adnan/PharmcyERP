<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:PharmacyERP.WPF.Views.Purchasing" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Purchasing.GoodsReceiptEditDialog" Title="{Binding DialogTitle}" Height="720" Width="960" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" Padding="16" Style="{StaticResource WorkspaceCardStyle}">
        <DockPanel Margin="0">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12" DockPanel.Dock="Top"/>
            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Content="حفظ كمسودة · Ctrl+S" Click="SaveButton_Click" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
            <local:GoodsReceiptEditor/>
        </DockPanel>
    </Border>
</Window>
