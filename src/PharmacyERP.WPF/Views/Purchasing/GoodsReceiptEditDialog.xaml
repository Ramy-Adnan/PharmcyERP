<Window x:Class="PharmacyERP.WPF.Views.Purchasing.GoodsReceiptEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:PharmacyERP.WPF.Views.Purchasing"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="720" Width="960"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="حفظ كمسودة" Command="{Binding SaveCommand}" Padding="18,8" Background="#1F6F50"
                    Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
        <local:GoodsReceiptEditor/>
    </DockPanel>
</Window>
