<Window x:Class="PharmacyERP.WPF.Views.Purchasing.PurchaseOrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="680" Width="880"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Rows="2">
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="المورد" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SupplierId}" Padding="6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding BranchId}" Padding="6"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="المخزن" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding WarehouseId}" Padding="6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="تاريخ الطلب" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding OrderDate}" Padding="6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="التسليم المتوقع" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate}" Padding="6"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10">
                    <TextBlock Text="نوع الشراء / نسبة زيادة البيع" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PurchaseTypes}" DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding PurchaseType}" Padding="6" Margin="0,0,0,8"/>
                    <TextBlock Text="تغيير النوع أو سعر الشراء يعيد الحساب؛ يمكنك تعديل البيع بعد ذلك." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="إضافة سطر" Padding="12,6" Margin="0,0,8,0" Command="{Binding AddLineCommand}"/>
                    <Button Content="حذف السطر" Padding="12,6" Foreground="#DC2626" Command="{Binding RemoveLineCommand}"/>
                </StackPanel>

                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="الصنف" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="ItemCombo"
                                              ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ItemId}"
                                              SelectionChanged="ItemCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="تعبئة وحدة الشراء" Binding="{Binding PurchaseUnitDescription}" Width="135" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityOrdered, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="شراء العبوة" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="بيع العبوة" Binding="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTemplateColumn Header="إعادة" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding MarkupLabel}" Command="{Binding CalculateSalePriceCommand}" ToolTip="{Binding RecalculatePriceLabel}" Padding="3,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الضريبة %" Binding="{Binding TaxRatePercent, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
