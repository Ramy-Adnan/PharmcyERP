<UserControl x:Class="PharmacyERP.WPF.Views.Purchasing.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="فواتير الشراء" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="فاتورة شراء جديدة" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddInvoiceCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تسجيل دفعة" Padding="12,6" Margin="0,0,8,0" Background="#1F6F50" Foreground="White" BorderThickness="0"
                            Command="{Binding RecordPaymentCommand}"/>
                    <Button Content="إلغاء الفاتورة" Padding="12,6" Foreground="#DC2626" Command="{Binding CancelInvoiceCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="مستند الاستلام" Binding="{Binding GoodsReceiptNumber}" Width="110"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="105"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn Header="المدفوع" Binding="{Binding AmountPaid, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding AmountDue, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
