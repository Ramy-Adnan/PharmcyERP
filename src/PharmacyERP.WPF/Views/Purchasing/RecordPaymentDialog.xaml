<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Purchasing.RecordPaymentDialog" Title="تسجيل دفعة" Height="460" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13" MinHeight="400" MinWidth="400" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" Padding="16" Style="{StaticResource WorkspaceCardStyle}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="2">
                <StackPanel>
                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='فاتورة رقم: {0}'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AmountDue, StringFormat='المبلغ المتبقي: {0:N2}'}" Foreground="#6B7280" Margin="0,0,0,16"/>
                    <TextBlock Text="مبلغ الدفعة" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding CanEditPayment}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPayment}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" Grid.Row="3">
                <WrapPanel HorizontalAlignment="Left" Margin="0">
                    <Button Content="{Binding SaveLabel}" Click="SaveButton_Click" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
