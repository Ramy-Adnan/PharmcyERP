<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Purchasing.PurchaseOrdersView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="أوامر الشراء" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="أمر شراء جديد" Margin="16,0,0,0" Command="{Binding AddOrderCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Style="{StaticResource WorkspaceCardStyle}">
            <DockPanel>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditOrderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="اعتماد" Margin="0,0,8,0" Command="{Binding SubmitOrderCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="إلغاء الأمر" Margin="0,0,8,0" Command="{Binding CancelOrderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="حذف" Command="{Binding DeleteOrderCommand}" Style="{StaticResource DangerButtonStyle}"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" MinRowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="120"/>
                        <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="التسليم المتوقع" Binding="{Binding ExpectedDeliveryDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding LineCount}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
