<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Purchasing.SuppliersView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="الموردون" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="مورد جديد" Margin="16,0,0,0" Command="{Binding AddSupplierCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Style="{StaticResource WorkspaceCardStyle}">
            <DockPanel>
                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12" DockPanel.Dock="Bottom">
                    <WrapPanel Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding EditSupplierCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="تفعيل / تعطيل" Command="{Binding ToggleStatusCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" FontSize="13" Style="{StaticResource WorkspaceDataGridStyle}" MinRowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="80"/>
                        <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="جهة الاتصال" Binding="{Binding ContactPerson}" Width="140"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="مدة السداد (يوم)" Binding="{Binding PaymentTermsDays}" Width="110"/>
                        <DataGridTextColumn Header="أوامر شراء مفتوحة" Binding="{Binding OpenPurchaseOrderCount}" Width="120"/>
                        <DataGridTextColumn Header="رصيد مستحق" Binding="{Binding TotalOutstandingBalance, StringFormat=N2}" Width="110"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
