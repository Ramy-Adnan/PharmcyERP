<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PharmacyERP.WPF.Views.Purchasing" x:Class="PharmacyERP.WPF.Views.Purchasing.PurchasingWorkspaceView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource WorkspaceCardStyle}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SavingMouseDown"/>
                <EventSetter Event="PreviewKeyDown" Handler="SavingKeyDown"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SavingMouseDown"/>
                <EventSetter Event="PreviewKeyDown" Handler="SavingKeyDown"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Margin="0,0,0,12">
            <DockPanel Margin="0">
                <StackPanel DockPanel.Dock="Right">
                    <TextBlock Text="المشتريات" Style="{StaticResource WorkspacePageTitleStyle}"/>
                    <TextBlock Text="من استلام البضاعة إلى متابعة مبلغ المورد، في مكان واحد" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="بدء عملية جديدة" Command="{Binding NewPurchaseCommand}" Style="{StaticResource Action}" Visibility="{Binding IsSupplierStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="تحديث السجلات" Command="{Binding RefreshCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" IsEnabled="{Binding CanInteract}">
            <TabItem Header="عملية شراء خطوة بخطوة">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupplierStep}" Value="True">
                                            <Setter Property="Background" Value="#DDF3E8"/>
                                            <Setter Property="BorderBrush" Value="#1F6F50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="① المورد" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoodsStep}" Value="True">
                                            <Setter Property="Background" Value="#DDF3E8"/>
                                            <Setter Property="BorderBrush" Value="#1F6F50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="② البضاعة والمخزن" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInvoiceStep}" Value="True">
                                            <Setter Property="Background" Value="#DDF3E8"/>
                                            <Setter Property="BorderBrush" Value="#1F6F50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="③ فاتورة المورد" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentStep}" Value="True">
                                            <Setter Property="Background" Value="#DDF3E8"/>
                                            <Setter Property="BorderBrush" Value="#1F6F50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="④ التسديد والمتبقي" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                        </Border>
                    </UniformGrid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="{Binding StepTitle}" Style="{StaticResource WorkspacePageTitleStyle}"/>
                        <TextBlock Text="{Binding StepHint}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SelectedSupplier.Name, StringFormat=المورد: {0}}" FontWeight="SemiBold" Foreground="#1F6F50" Margin="0,6,0,0"/>
                        <StackPanel Visibility="{Binding IsGoodsStep, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding CanInteract}">
                            <Button Content="علاج غير مسجل؟ أضف بطاقة علاج" Click="AddItemClicked" Style="{StaticResource Action}" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding CanManageItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="استيراد فاتورة من صورة" Click="ImportPhotoClicked" Style="{StaticResource Action}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" IsEnabled="{Binding CanInteract}" Style="{StaticResource WorkspaceCardStyle}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSupplierStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="المورد الذي وصلت منه البضاعة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSupplierId}" IsEnabled="{Binding CanChangeSupplier}" Padding="10" MaxWidth="600" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding SelectedSupplier.TotalOutstandingBalance, StringFormat=المتبقي لهذا المورد من الفواتير السابقة: {0:N2}}" Foreground="#64748B" Margin="0,8,0,12"/>
                                    <Expander Header="المورد غير مسجل؟ أضفه هنا" Visibility="{Binding CanAddSupplier, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,16">
                                        <StackPanel Margin="12">
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="رمز المورد"/>
                                                    <TextBox Text="{Binding SupplierEditor.Code, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="اسم المورد"/>
                                                    <TextBox Text="{Binding SupplierEditor.Name, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="الهاتف"/>
                                                    <TextBox Text="{Binding SupplierEditor.Phone, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="مدة السداد بالأيام (0 للدفع الفوري)" Margin="0,8,0,4"/>
                                            <TextBox Text="{Binding SupplierEditor.PaymentTermsDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="180" HorizontalAlignment="Right"/>
                                            <Button Content="حفظ المورد واختياره" Command="{Binding SaveSupplierCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="استكمال عملية سابقة" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                                            <DockPanel Margin="0,0,0,10" Visibility="{Binding CanReceiveGoods, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button DockPanel.Dock="Left" Content="فتح الاستلام" Command="{Binding ResumeReceiptCommand}" Style="{StaticResource Action}"/>
                                                <ComboBox ItemsSource="{Binding ReceiptsToResume}" SelectedItem="{Binding SelectedReceiptToResume}" Padding="6">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <Run Text="{Binding Number}"/>
                                                                <Run Text=" — "/>
                                                                <Run Text="{Binding SupplierName}"/>
                                                                <Run Text=" — "/>
                                                                <Run Text="{Binding ReceiptDate, StringFormat=yyyy-MM-dd}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                            <DockPanel Visibility="{Binding CanManageInvoices, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button DockPanel.Dock="Left" Content="فتح التسديد" Command="{Binding ResumeInvoiceCommand}" Style="{StaticResource Action}"/>
                                                <ComboBox ItemsSource="{Binding InvoicesToResume}" SelectedItem="{Binding SelectedInvoiceToResume}" Padding="6">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <Run Text="{Binding Number}"/>
                                                                <Run Text=" — "/>
                                                                <Run Text="{Binding SupplierName}"/>
                                                                <Run Text=" — المتبقي: "/>
                                                                <Run Text="{Binding AmountDue, StringFormat=N2}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <local:GoodsReceiptEditor DataContext="{Binding Receipt}" HeaderSelectionEnabled="False" Visibility="{Binding DataContext.IsGoodsStep, RelativeSource={RelativeSource AncestorType=local:PurchasingWorkspaceView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <local:PurchaseInvoiceEditor DataContext="{Binding InvoiceEditor}" HeaderSelectionEnabled="False" Visibility="{Binding DataContext.IsInvoiceStep, RelativeSource={RelativeSource AncestorType=local:PurchasingWorkspaceView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsPaymentStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Invoice.Number}" FontSize="18" FontWeight="Bold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                                    <TextBlock Text="{Binding PaymentStatus}" Foreground="#1F6F50" Margin="0,6,0,16" FontWeight="SemiBold"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,20">
                                        <Border Style="{StaticResource StepCard}">
                                            <StackPanel>
                                                <TextBlock Text="إجمالي فاتورة المورد"/>
                                                <TextBlock Text="{Binding Invoice.TotalAmount, StringFormat=N2}" FontSize="24" FontWeight="Bold" Style="{StaticResource WorkspaceSectionHeaderStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StepCard}">
                                            <StackPanel>
                                                <TextBlock Text="المدفوع للمورد"/>
                                                <TextBlock Text="{Binding Invoice.AmountPaid, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#1F6F50"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StepCard}">
                                            <StackPanel>
                                                <TextBlock Text="المتبقي عليك للمورد"/>
                                                <TextBlock Text="{Binding Invoice.AmountDue, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="#B45309"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Text="المبلغ الذي ستدفعه الآن" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding CanEditPaymentAmount}" Padding="10" Width="260" HorizontalAlignment="Right"/>
                                    <WrapPanel Margin="0,12,0,12">
                                        <Button Content="تعبئة كامل المتبقي" Command="{Binding PayInFullCommand}" Style="{StaticResource Action}"/>
                                        <Button Content="{Binding PaymentActionLabel}" Command="{Binding PayCommand}" Style="{StaticResource PrimaryAction}"/>
                                    </WrapPanel>
                                    <TextBlock Text="إذا لم تدفع الآن، تبقى الفاتورة غير مسددة. يمكنك بدء شراء جديد والعودة لتسديدها لاحقاً." TextWrapping="Wrap" Foreground="#64748B"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#DC2626" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#1F6F50" Margin="0,0,0,6"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReceiptLabel}" Foreground="#64748B" VerticalAlignment="Center"/>
                            <WrapPanel HorizontalAlignment="Left">
                                <Button Content="السابق" Command="{Binding BackCommand}" Style="{StaticResource Action}" Visibility="{Binding IsGoodsStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="حفظ مسودة للمتابعة لاحقاً" Command="{Binding SaveDraftCommand}" Style="{StaticResource Action}" Visibility="{Binding IsGoodsStep, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryAction}" FontWeight="SemiBold"/>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="السجلات والمتابعة">
                <TabControl Margin="0,12,0,0" Background="Transparent" BorderThickness="0">
                    <TabItem Header="الموردون" Visibility="{Binding CanManageSuppliers, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl x:Name="SuppliersHistory"/>
                    </TabItem>
                    <TabItem Header="أوامر الشراء (اختياري)" Visibility="{Binding CanManageOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl x:Name="OrdersHistory"/>
                    </TabItem>
                    <TabItem Header="سندات الاستلام" Visibility="{Binding CanReceiveGoods, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl x:Name="ReceiptsHistory"/>
                    </TabItem>
                    <TabItem Header="الفواتير والتسديد" Visibility="{Binding CanManageInvoices, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl x:Name="InvoicesHistory"/>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
