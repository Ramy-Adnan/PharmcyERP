<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Purchasing.SupplierEditDialog" Title="{Binding DialogTitle}" Height="680" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="{DynamicResource WorkspaceFont}" FontSize="13" MinHeight="520" MinWidth="420" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" Padding="16" Style="{StaticResource WorkspaceCardStyle}">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="رمز المورد" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="اسم المورد" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="جهة الاتصال" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="العنوان" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الرقم الضريبي" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="مدة السداد (بالأيام)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentTermsDays, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" Grid.Row="3">
                <WrapPanel HorizontalAlignment="Left" Margin="0">
                    <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
