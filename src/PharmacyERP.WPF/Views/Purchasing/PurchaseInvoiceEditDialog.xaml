<Window x:Class="PharmacyERP.WPF.Views.Purchasing.PurchaseInvoiceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة شراء جديدة" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="المورد" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SupplierId}" Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="مستند استلام مُرحّل (اختياري)" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding PostedGoodsReceipts}" DisplayMemberPath="Number" SelectedValuePath="Id"
                              SelectedValue="{Binding GoodsReceiptNoteId}" Padding="6"/>
                    <Button Grid.Column="2" Content="تحميل" Padding="10,6" Command="{Binding LoadFromGoodsReceiptCommand}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="4">
                <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding BranchId}" Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="تاريخ الفاتورة" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding InvoiceDate}" Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="تاريخ الاستحقاق" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding DueDate}" Padding="6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="4">
                <TextBlock Text="مبلغ الخصم" Margin="0,0,0,4"/>
                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="إضافة سطر" Padding="12,6" Margin="0,0,8,0" Command="{Binding AddLineCommand}"/>
                    <Button Content="حذف السطر" Padding="12,6" Foreground="#DC2626" Command="{Binding RemoveLineCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <TextBlock Text="الإجمالي النهائي: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat=N2}" FontWeight="Bold" Foreground="#1F6F50"/>
                </StackPanel>

                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="32" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="الصنف" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="ItemCombo"
                                              ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ItemId}"
                                              SelectionChanged="ItemCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="سعر الشراء" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                        <DataGridTextColumn Header="الضريبة %" Binding="{Binding TaxRatePercent, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridTextColumn Header="خصم السطر" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
