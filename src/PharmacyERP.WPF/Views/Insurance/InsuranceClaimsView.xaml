<UserControl x:Class="PharmacyERP.WPF.Views.Insurance.InsuranceClaimsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="مطالبات التأمين" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="تقديم مطالبة جديدة" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SubmitClaimCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تحديث حالة المطالبة" Padding="12,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                            Command="{Binding ProcessClaimCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Claims}" SelectedItem="{Binding SelectedClaim}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المطالبة" Binding="{Binding ClaimNumber}" Width="130"/>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding SalesInvoiceNumber}" Width="110"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="شركة التأمين" Binding="{Binding InsuranceCompanyName}" Width="150"/>
                        <DataGridTextColumn Header="المبلغ المطالب به" Binding="{Binding ClaimedAmount, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="المبلغ المعتمد" Binding="{Binding ApprovedAmount, StringFormat=N2}" Width="105"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="تاريخ التقديم" Binding="{Binding SubmittedAtUtc, StringFormat=yyyy-MM-dd}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
