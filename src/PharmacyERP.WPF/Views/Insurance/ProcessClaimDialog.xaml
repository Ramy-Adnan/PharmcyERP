<Window x:Class="PharmacyERP.WPF.Views.Insurance.ProcessClaimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحديث حالة المطالبة" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Claim.ClaimNumber, StringFormat='مطالبة رقم: {0}'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Claim.ClaimedAmount, StringFormat='المبلغ المطالب به: {0:N2}'}" Foreground="#6B7280" Margin="0,0,0,16"/>

            <TextBlock Text="الحالة الجديدة" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding NewStatus}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="المبلغ المعتمد" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ApprovedAmount, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
