<Window x:Class="PharmacyERP.WPF.Views.Hr.EmployeeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Height="700" Width="480"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="رمز الموظف" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الاسم الكامل" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الرقم الوطني" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="العنوان" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="المسمى الوظيفي" Margin="0,0,0,4"/>
                <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="تاريخ التعيين" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding HireDate}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الوردية (اختياري)" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding ShiftId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="حساب الدخول المرتبط (اختياري)" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding LinkableUsers}" DisplayMemberPath="FullName" SelectedValuePath="Id"
                          SelectedValue="{Binding UserId}" Padding="6" Margin="0,0,0,12"/>

                <TextBlock Text="الراتب الأساسي الشهري" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MonthlyBaseSalary, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

                <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="حفظ" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
