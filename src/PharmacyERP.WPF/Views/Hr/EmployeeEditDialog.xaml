<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.EmployeeEditDialog" Title="{Binding DialogTitle}" Height="700" Width="480" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize" MinWidth="480" MinHeight="440">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="2" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="رمز الموظف" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الاسم الكامل" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الرقم الوطني" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الهاتف" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="العنوان" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="المسمى الوظيفي" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="تاريخ التعيين" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding HireDate}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الوردية (اختياري)" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ShiftId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="حساب الدخول المرتبط (اختياري)" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding LinkableUsers}" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectedValue="{Binding UserId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="الراتب الأساسي الشهري" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MonthlyBaseSalary, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <CheckBox Content="نشط" IsChecked="{Binding IsActive}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="3" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12" Margin="0,16,0,0">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
