<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.ShiftsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="الورديات" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="وردية جديدة" Margin="16,0,0,0" Command="{Binding AddShiftCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DockPanel>
                <Border Style="{StaticResource WorkspaceCardStyle}" DockPanel.Dock="Bottom" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12" Margin="10">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="تعديل" Command="{Binding EditShiftCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </WrapPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Style="{StaticResource WorkspaceDataGridStyle}" HorizontalGridLinesBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الوردية" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="وقت البداية" Binding="{Binding StartTime, StringFormat=hh\\:mm}" Width="110"/>
                        <DataGridTextColumn Header="وقت النهاية" Binding="{Binding EndTime, StringFormat=hh\\:mm}" Width="110"/>
                        <DataGridTextColumn Header="عدد الموظفين" Binding="{Binding EmployeeCount}" Width="100"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
