<UserControl x:Class="PharmacyERP.WPF.Views.Hr.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الموظفون" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="موظف جديد" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding AddEmployeeCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="تحديث" Margin="8,0,0,0" Padding="14,6" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Left">
                    <Button Content="تعديل" Padding="12,6" Margin="0,0,8,0" Command="{Binding EditEmployeeCommand}"/>
                    <Button Content="تفعيل / إنهاء خدمة" Padding="12,6" Command="{Binding ToggleStatusCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                          RowHeight="34" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding EmployeeCode}" Width="80"/>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle}" Width="130"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="110"/>
                        <DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="100"/>
                        <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding MonthlyBaseSalary, StringFormat=N2}" Width="105"/>
                        <DataGridTextColumn Header="تاريخ التعيين" Binding="{Binding HireDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
