<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.MarkPayrollRunPaidDialog" Title="تسجيل صرف الرواتب" Height="560" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="440" MinHeight="440">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="2" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding PayrollRunNumber, StringFormat='دورة رواتب: {0}'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalNetPay, StringFormat='إجمالي الصافي المستحق: {0:N2}'}" Foreground="#6B7280" Margin="0,0,0,16"/>
                    <TextBlock Text="تاريخ الصرف" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding PaymentDate}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="مصدر الصرف" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}" Padding="6" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding IsCashSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="الصندوق النقدي" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CashBoxes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding CashBoxId}" Padding="6" Margin="0,0,0,12"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBankSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="الحساب البنكي" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BankAccounts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BankAccountId}" Padding="6" Margin="0,0,0,12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="3" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12" Margin="0,16,0,0">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="تأكيد الصرف" Background="#B45309" Foreground="White" BorderThickness="0" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
