<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.AttendanceView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="الحضور والانصراف" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="تسجيل يدوي" Margin="16,0,0,0" Command="{Binding RecordAttendanceCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="2">
            <WrapPanel>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,10,8"/>
                <TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,10,8"/>
                <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="FullName" SelectedItem="{Binding SelectedEmployeeFilter}" Padding="6" Margin="0,0,10,8" Width="220"/>
                <Button Content="بحث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8"/>
                <Button Content="تسجيل دخول" Command="{Binding CheckInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8"/>
                <Button Content="تسجيل خروج" Background="#B45309" Foreground="White" BorderThickness="0" Command="{Binding CheckOutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedAttendance}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Style="{StaticResource WorkspaceDataGridStyle}" HorizontalGridLinesBrush="#E5E7EB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="وقت الدخول" Binding="{Binding CheckInAtUtc, StringFormat='HH:mm'}" Width="90"/>
                    <DataGridTextColumn Header="وقت الخروج" Binding="{Binding CheckOutAtUtc, StringFormat='HH:mm'}" Width="90"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
