<UserControl x:Class="PharmacyERP.WPF.Views.Hr.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="الحضور والانصراف" FontSize="20" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            <Button Content="تسجيل يدوي" Margin="16,0,0,0" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding RecordAttendanceCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0" SelectedDate="{Binding FromDate}" Width="130"/>
            <TextBlock Grid.Column="2" Text="إلى" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="4" SelectedDate="{Binding ToDate}" Width="130"/>

            <ComboBox Grid.Column="6" ItemsSource="{Binding Employees}" DisplayMemberPath="FullName"
                      SelectedItem="{Binding SelectedEmployeeFilter}" Padding="6"/>

            <Button Grid.Column="8" Content="بحث" Padding="14,6" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="10" Content="تسجيل دخول" Padding="14,6" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding CheckInCommand}"/>
            <Button Grid.Column="12" Content="تسجيل خروج" Padding="14,6" Background="#B45309" Foreground="White" BorderThickness="0"
                    Command="{Binding CheckOutCommand}"/>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedAttendance}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                      RowHeight="34" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding AttendanceDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="وقت الدخول" Binding="{Binding CheckInAtUtc, StringFormat='HH:mm'}" Width="90"/>
                    <DataGridTextColumn Header="وقت الخروج" Binding="{Binding CheckOutAtUtc, StringFormat='HH:mm'}" Width="90"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
