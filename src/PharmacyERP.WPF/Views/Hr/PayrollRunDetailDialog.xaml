<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.PayrollRunDetailDialog" Title="تفاصيل دورة الرواتب" Height="690" Width="880" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize" MinWidth="700" MinHeight="440">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <UniformGrid Columns="5">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الرقم" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Number}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الفرع" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.BranchName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="الفترة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock FontWeight="SemiBold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:yyyy-MM-dd} إلى {1:yyyy-MM-dd}">
                                <Binding Path="Header.PeriodStart"/>
                                <Binding Path="Header.PeriodEnd"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="إجمالي الصافي" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.TotalNetPay, StringFormat=N2}" FontWeight="Bold" Foreground="#1F6F50" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Header.Status}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </UniformGrid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Style="{StaticResource WorkspaceDataGridStyle}" HorizontalGridLinesBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                        <DataGridTextColumn Header="الوظيفة" Binding="{Binding JobTitle}" Width="110"/>
                        <DataGridTextColumn Header="الأساسي" Binding="{Binding BaseSalary, StringFormat=N2}" Width="85"/>
                        <DataGridTextColumn Header="العمولات" Binding="{Binding TotalCommissions, StringFormat=N2}" Width="85"/>
                        <DataGridTextColumn Header="الاستقطاعات" Binding="{Binding Deductions, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="الصافي" Binding="{Binding NetPay, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="تعديل استقطاعات الموظف المحدد" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="مبلغ الاستقطاع" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditableDeductions, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                        <TextBlock Text="سبب الاستقطاع" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditableDeductionNotes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                        <Button Content="حفظ الاستقطاع" Command="{Binding SaveDeductionCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="5" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="اعتماد الدورة" Command="{Binding ApproveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="تسجيل الصرف (دفع الرواتب)" Background="#B45309" Foreground="White" BorderThickness="0" Command="{Binding MarkPaidCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="إغلاق" Click="CloseButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
