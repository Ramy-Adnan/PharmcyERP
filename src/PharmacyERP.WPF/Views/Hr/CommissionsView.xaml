<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.CommissionsView" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource WorkspaceToolbarStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="عمولات الموظفين" VerticalAlignment="Center" Style="{StaticResource WorkspacePageTitleStyle}"/>
                <Button Content="عمولة جديدة" Margin="16,0,0,0" Command="{Binding AddCommissionCommand}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="تحديث" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Style="{StaticResource WorkspaceCardStyle}" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Commissions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0" Style="{StaticResource WorkspaceDataGridStyle}" HorizontalGridLinesBrush="#E5E7EB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="رقم فاتورة البيع" Binding="{Binding SalesInvoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CommissionDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                    <DataGridCheckBoxColumn Header="مدفوعة" Binding="{Binding IsPaid}" Width="70"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
