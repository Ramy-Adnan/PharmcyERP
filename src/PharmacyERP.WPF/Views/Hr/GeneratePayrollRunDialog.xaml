<Window x:Class="PharmacyERP.WPF.Views.Hr.GeneratePayrollRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دورة رواتب جديدة" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="الفرع" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="بداية الفترة" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding PeriodStart}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="نهاية الفترة" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding PeriodEnd}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="سيتم احتساب الراتب الأساسي وأي عمولات غير مدفوعة ضمن الفترة لكل موظف نشط في هذا الفرع."
                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="إنشاء" Padding="18,8" Background="#1F6F50" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Padding="18,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
