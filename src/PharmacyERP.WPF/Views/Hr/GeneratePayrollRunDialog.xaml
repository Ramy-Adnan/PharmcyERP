<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PharmacyERP.WPF.Views.Hr.GeneratePayrollRunDialog" Title="دورة رواتب جديدة" Height="560" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="RightToLeft" Background="#F9FAFB" FontFamily="/PharmacyERP.WPF;component/Resources/Fonts/#Cairo" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="440" MinHeight="440">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PharmacyERP.WPF;component/Themes/WorkspaceTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceToolbarStyle}">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource WorkspacePageTitleStyle}" TextWrapping="Wrap"/>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="2" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="الفرع" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BranchId}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="بداية الفترة" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding PeriodStart}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="نهاية الفترة" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding PeriodEnd}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="ملاحظات" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,12"/>
                    <TextBlock Text="سيتم احتساب الراتب الأساسي وأي عمولات غير مدفوعة ضمن الفترة لكل موظف نشط في هذا الفرع." TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Style="{StaticResource WorkspaceCardStyle}" Grid.Row="3" Background="#F9FAFB" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="12" Margin="0,16,0,0">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إنشاء" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="إلغاء" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
