<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!--
      DevExpress feed — required only by PharmacyERP.WPF.
      Uncomment and replace YOUR_FEED_KEY with the key from your DevExpress account
      (Downloads > NuGet Feed). It is left commented out because an invalid placeholder
      URL here causes every `dotnet restore` in the solution to fail with NU1301,
      including for projects that have no DevExpress dependency at all.
    -->
    <!-- <add key="DevExpress" value="https://nuget.devexpress.com/YOUR_FEED_KEY/api" /> -->
  </packageSources>
</configuration>
